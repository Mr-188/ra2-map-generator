{
  "$schema": "https://cdnstatic.tencentcs.com/edgeone/pages/docs/edgeone.schema.json",

  "headers": [
    {
      "source": "/*.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/render/_framework/*.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/mg_engine.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/package.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],

  "caches": [
    { "source": "/mg_engine.wasm", "cacheTtl": 604800 },
    { "source": "/render/_framework/*", "cacheTtl": 604800 }
  ]
}
