+// ===========================================================================
+// MirrorShape - the shape, before any art is chosen for it.
+//
+// What the shape consists of at this point was read off GenerateMapBody
+// (MapGen.cpp:697): it marks every cell with waterTileIndex_, grows the land with
+// GenerateArchipelago/GenerateContinent/GenerateTeamContinent, smooths the water
+// and clears the work array.  So the shape after it is exactly
+//   * IsoTileTypeIndex  the land/water mark (waterTileIndex_ = water)
+//   * Level             the elevation
+//   * Height            zero on everything the shape stage touched
+// and ClearWorkOccupancy() has already wiped workCells_, so nothing there needs
+// mirroring.
+//
+// The shape stage also leaves ShorePieces along the coast in some paths (see the
+// rollback branch that zeroes them), and those are real art with an orientation.
+// They are put through MirrorTile as well, so whether the later stages overwrite
+// them or not, nothing orientation-bearing is left facing the old way.
+// ===========================================================================
+bool RandomMapGenerator::MirrorShape(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorShape: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && kind != mg::MapSymmetry::Rotational180)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorShape: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+
+    // Both kinds are involutions of the diamond, so each pair is acted on once:
+    // only the half that sorts before its own image is swapped.
+    long long swapped = 0, unpaired = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;                           // not a cell of the diamond
+            if (!(x < mx || (x == mx && y < my)))
+                continue;                           // its image handles this pair
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                // MirrorCell says the image is a cell, so its slot must hold one.
+                ++unpaired;
+                continue;
+            }
+            // COPY, not swap.  Swapping a pair produces the MIRROR IMAGE of the
+            // map, which is not a symmetric map at all: the operation preserves
+            // whether the two cells agreed, so a pair that disagreed still
+            // disagrees.  Measured: with the swap, 802 of 6460 pairs disagreed
+            // about "is this water" after the pass - and an UNMIRRORED map scores
+            // the same 0.877 on water/land self-symmetry, so the swap was doing
+            // nothing at all.  A symmetric map needs the authoritative half copied
+            // onto its image.
+            b->IsoTileTypeIndex = a->IsoTileTypeIndex;
+            b->Level = a->Level;
+            b->Height = a->Height;
+            ++swapped;
+        }
+    }
+    if (unpaired > 0)
+    {
+        std::fprintf(stderr, "[symmetry] WARNING: MirrorShape found %lld mirrored "
+                     "pairs with no slot on one side; the shape is only partly "
+                     "mirrored\n", unpaired);
+        return false;
+    }
+
+    // Orientation-bearing marks that came with the shape (the coast's shore
+    // pieces).  MirrorTile answers -1 for anything that is not a multi-cell family
+    // member - which the plain land/water mark is - and for a family member with
+    // no counterpart, which is counted so it cannot pass unnoticed.
+    long long pieces = 0, turned = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* c = cellSlots_[512 * y + x];
+            if (c == nullptr)
+                continue;
+            int cols = 0, rows = 0;
+            if (!TileFootprint(c->IsoTileTypeIndex, &cols, &rows) || cols * rows <= 1)
+                continue;
+            ++pieces;
+            int height = c->Height;
+            const int partner = MirrorTile(c->IsoTileTypeIndex, kind, &height);
+            if (partner < 0)
+                continue;
+            c->IsoTileTypeIndex = partner;
+            c->Height = height;
+            ++turned;
+        }
+    }
+
+    std::fprintf(stderr,
+                 "[symmetry] shape: %s, copied %lld cell pairs onto their images, %lld/%lld "
+                 "orientation-bearing shape pieces turned\n",
+                 mg::MapSymmetryName(kind), swapped, turned, pieces);
+
+    // ---- the pass measured against itself --------------------------------
+    //
+    // The rendered map cannot tell whether a shape mirror worked: measured on this
+    // generator, an UNMIRRORED map scores 0.877 on water/land self-symmetry all by
+    // itself, which is exactly what a mirrored one scored while this pass was doing
+    // nothing useful.  So the pass reports its own result instead, over the whole
+    // diamond: how many mirrored pairs disagree about "is this water", plus how
+    // many cells carry the water mark, the land mark and something else.  A working
+    // mirror has to report 0 disagreeing pairs here.
+    {
+        long long disagree = 0, pairs = 0, water = 0, land = 0, other = 0;
+        for (int y = 0; y < slotRows_; ++y)
+        {
+            for (int x = 0; x < 512; ++x)
+            {
+                MapCell* a = cellSlots_[512 * y + x];
+                if (a == nullptr)
+                    continue;
+                if (a->IsoTileTypeIndex == waterTileIndex_) ++water;
+                else if (a->IsoTileTypeIndex == 0) ++land;
+                else ++other;
+
+                int mx = 0, my = 0;
+                if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                    continue;
+                if (!(x < mx || (x == mx && y < my)))
+                    continue;
+                MapCell* b = cellSlots_[512 * my + mx];
+                if (b == nullptr)
+                    continue;
+                ++pairs;
+                if ((a->IsoTileTypeIndex == waterTileIndex_)
+                    != (b->IsoTileTypeIndex == waterTileIndex_))
+                    ++disagree;
+            }
+        }
+        std::fprintf(stderr,
+                     "[symmetry] shape self-check: %lld mirrored pairs, %lld disagree "
+                     "about water; cells: water=%lld land=%lld other=%lld\n",
+                     pairs, disagree, water, land, other);
+    }
+    return true;
+}
+
+// ===========================================================================
+// MirrorMap - what is PLACED, after the shape has already been mirrored.
+//
+// The overlay layer: AddTiberium and the tech buildings run after MirrorShape, so
+// the ore sits wherever the generator put it on the mirrored shape and has to be
+// reflected for the two halves to match.  Ore overlays carry no orientation (a
+// random 0..11 variant plus a growth counter, MapGenTiberium.cpp), so moving them
+// verbatim is exact - and it is the reason this pass must not touch the tiles,
+// which are the thing that cannot be moved.
+//
+// The four ledgers: startingPoints_ (and therefore [Waypoints] and the
+// single-player HomeCell/AltHomeCell fields the writer derives from
+// startingPoints_[0].index), waypoints_, the terrain objects and the structures -
+// the latter with `facing` mapped too.
+//
+// NOT mirrored, deliberately:
+//   * IsoTileTypeIndex / Height / Level - the shape was mirrored before the art was
+//     chosen for it; moving them again would undo exactly what makes the render
+//     correct.  This is the whole point of the two-phase split.
+//   * SlopeIndex - it drives the ramp art (MapGenRecalc.cpp:918-965 reads the
+//     cell's own value and two neighbours'), and the art has already been chosen
+//     for the mirrored shape, so it must stay with the art it produced.  Reflecting
+//     it here would make the stored value disagree with the tiles.
+//   * levelAndPassability_ / movementZones_ - read only by
+//     RecalculateCellAttributes and GetMoveError, both of which have already run,
+//     and Cleanup() frees them immediately after this pass.
+// ===========================================================================
+bool RandomMapGenerator::MirrorMap(mg::MapSymmetry kind)
+{
+    // -----------------------------------------------------------------------
+    // [移植侧] 已测并否决：纹理级"整半场镜像"（把 1x1 单格瓦片从权威半场镜像过来）。
+    //
+    // 动机仍然是那个差距：官方手绘对称图（画面竖中线为轴，左半 vs 右半翻转）12.1 / >20 19.3%
+    // / 暗像素 0.09%，我们当前 20.3 / 40.4% / 0.05%，差在 20~60 那段纹理。
+    //
+    // 结果：纹理确实镜像上了（>20 从 40.4% 降到 28.8%，接近官方），**但暗像素 0.05% -> 2.09%**，
+    // 又是黑缝。连同这一版共试了四种变体，全都这样：
+    //   ① 只搬 瓦片+子帧+坡面号；② 跳过岸族；③ 整格结构拷贝（保留自身坐标）；
+    //   ④ 只搬 1x1、多格族全跳过（本版）。
+    // 结论：**事后重写镜像半场的瓦片层，这个引擎就会撕出黑缝**；瓦片必须由生成器自己的 pass
+    // 写（这也与更早那次"只抄 1x1 岸/水瓦片 -> 3.97%"一致）。
+    //
+    // 所以纹理那一半差距只能从**源头**补：让各个生成 pass 自己的随机决策也镜像共享
+    // （岸片已经这样做了，效果最大：镜像海岸对中位 24.6 -> 12.9），而不是事后搬瓦片。
+    // -----------------------------------------------------------------------
+
+    // -----------------------------------------------------------------------
+    // [移植侧] 已测并否决：把权威半场的**逐格瓦片数据整份镜像**到对面（整半场镜像）。
+    //
+    // 动机：官方手绘对称图在同一把尺子（以画面竖中线为轴，左半 vs 右半翻转）上是
+    // 平均差 12.1、差异>20 占 19.3%、暗像素 0.09%；我们当前是 20.3 / 40.4% / 0.05%。
+    // 差的正是 20~60 那一段纹理（>60 的大差异两边都是 3%，说明几何本来就对）。
+    //
+    // 结果：纹理确实镜像上了 —— 差异>20 从 40.4% 降到 28.9%/31.5%（接近官方 19.3%）——
+    // **但冒出黑缝：暗像素 0.05% -> 2.13%**。试过三种变体都一样：
+    //   ① 只搬 瓦片+子帧+坡面号；② 跳过岸族；③ 整格结构拷贝（保留自身坐标）。
+    // 说明还有某个参与渲染、又不在 MapCell 里的层没有跟着镜像（还没定位到）。
+    // 按"渲染为准"，黑缝不可接受，故撤销，行为保持当前已推送的版本。
+    // -----------------------------------------------------------------------
+
+    // -----------------------------------------------------------------------
+    // [移植侧] 海岸的镜像化到这里为止（本 pass 不再动岸片）。三层都量过：
+    //
+    // 1) 选片层：两半的岸片是同一张片（数据层 (片号,片内偏移) 完全一致）——也就是"海岸只做
+    //    一次决定"，任何缺陷都不会只出现在一侧。这是 SelectShoreTile 的 roll 镜像共享做到的。
+    // 2) 偏移层：试过在最后一道 pass 把镜像半场的片内偏移按镜像转置（早段做过一次，被随后的
+    //    岸片盖章按片内格号重算回去，诊断打印：写 3、落盘前又变回 1；放到 MirrorMap 里之后
+    //    确认落盘生效，134 格改变）。但渲染变差：镜像海岸对 平均 13.1 -> 18.1、中位 12.9 ->
+    //    18.8、最差 21.0 -> 27.0。所以"平移"比"强制镜像"好，撤销。
+    // 3) 美术层：这套瓦片集里不存在互为镜像的两片 —— 同一片与它自己的水平翻转的基线差就有
+    //    22，而现在的"平移"摆法已经做到 12.9，比那个基线还低。
+    //
+    // 结论：两半河岸做不到逐像素镜像；当前摆法（同一张片 + 生成器自己的镜像感知选择）是实测
+    // 最优。残余差异来自美术本身，不是铺错了。
+    // -----------------------------------------------------------------------
+
+
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorMap: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && kind != mg::MapSymmetry::Rotational180)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorMap: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+
+    // ---- the elevation of land types 3/4 is NOT re-copied here ---------------
+    //
+    // Tried, measured, rejected.  The carving-time copy fixes the half, but the stages
+    // after it write Level per cell from a running RNG (CreateHills above all), and the
+    // result is visible: on a size-2 Inland map 8830 of 13992 mirrored pairs disagreed
+    // on the elevation, and the mirrored water body rendered with a stepped edge on one
+    // side because its cells sat at different heights.  Copying the half once more right
+    // here - after every writer of Level - does close that (0 of 13992), but it breaks
+    // the RENDER: dark pixels went 0.39% -> 3.31% on Inland and 0.12% -> 2.59% on a snow
+    // Mountainous map, because each copied cell brings art that was chosen for the
+    // height it had on the other side.  The same lesson as on the continent types:
+    // elevation and art are one thing and cannot be moved separately.
+    //
+    // Closing the interior therefore needs the generator's own RNG-driven stages to
+    // choose mirror-consistently - a change inside them (one draw per mirrored pair,
+    // applied to both cells), not a pass over their output.
+
+    // ---- the overlay layer and the building flag ---------------------------
+    if (!MirrorOverlays(kind))
+        return false;
+
+    // ---- the ledgers: keep the authoritative half, then add its mirror -----
+    //
+    // A symmetric map has an object in BOTH halves, not one object moved to the
+    // other half, so each ledger keeps the entries on the authoritative side and
+    // appends mirrored copies of exactly those.  What sits on the axis (a cell that
+    // is its own image) is kept as it is and never duplicated.
+    auto authoritative = [&](const CellStruct& c) {
+        int mx = 0, my = 0;
+        if (!mg::MirrorCell(W, H, kind, c.X, c.Y, &mx, &my))
+            return true;                        // off the diamond: leave it alone
+        return c.X < mx || (c.X == mx && c.Y < my);
+    };
+    auto mirrorOf = [&](const CellStruct& c, int* ox, int* oy) {
+        return mg::MirrorCell(W, H, kind, c.X, c.Y, ox, oy);
+    };
+
+    {
+        std::vector<MapTerrainObject> kept, mirrored;
+        for (const MapTerrainObject& t : terrainObjects_)
+        {
+            if (!authoritative(t.coords))
+                continue;
+            kept.push_back(t);
+            int mx = 0, my = 0;
+            if (mirrorOf(t.coords, &mx, &my))
+            {
+                MapTerrainObject m = t;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                mirrored.push_back(m);
+            }
+        }
+        terrainObjects_ = kept;
+        terrainObjects_.insert(terrainObjects_.end(), mirrored.begin(), mirrored.end());
+    }
+    {
+        std::vector<MapStructure> kept, mirrored;
+        for (const MapStructure& s : structures_)
+        {
+            if (!authoritative(s.coords))
+                continue;
+            kept.push_back(s);
+            int mx = 0, my = 0;
+            if (mirrorOf(s.coords, &mx, &my))
+            {
+                MapStructure m = s;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                m.facing = MirrorFacing(kind, s.facing);
+                mirrored.push_back(m);
+            }
+        }
+        structures_ = kept;
+        structures_.insert(structures_.end(), mirrored.begin(), mirrored.end());
+    }
+
+    // Start points: the same rule, but a map whose starts all landed on one side
+    // would end up with none, so the other side becomes the source in that case.
+    // The count is preserved - a 2-player map stays a 2-player map.
+    {
+        std::vector<StartingPointRecord> kept, mirrored;
+        for (const StartingPointRecord& sp : startingPoints_)
+        {
+            if (!authoritative(sp.coords))
+                continue;
+            kept.push_back(sp);
+            int mx = 0, my = 0;
+            if (mirrorOf(sp.coords, &mx, &my))
+            {
+                StartingPointRecord m = sp;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                mirrored.push_back(m);
+            }
+        }
+        if (kept.empty())
+        {
+            for (const StartingPointRecord& sp : startingPoints_)
+            {
+                int mx = 0, my = 0;
+                if (!mirrorOf(sp.coords, &mx, &my))
+                    continue;
+                StartingPointRecord m = sp;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                kept.push_back(m);
+                mirrored.push_back(sp);
+            }
+        }
+        // The mirrored copies need a FREE index.  The writer emits [Waypoints] keyed
+        // by each record's index, so a copy that reuses its source's index collides
+        // with it and the map ends up with fewer start points than players
+        // (measured: 2 -> 1).  Kept entries keep their own indices and stay first,
+        // because the writer derives HomeCell from startingPoints_[0].index.
+        {
+            std::vector<bool> used(256, false);
+            for (const StartingPointRecord& sp : kept)
+                if (sp.index >= 0 && sp.index < 256)
+                    used[static_cast<size_t>(sp.index)] = true;
+            int next = 0;
+            for (StartingPointRecord& m : mirrored)
+            {
+                while (next < 256 && used[static_cast<size_t>(next)])
+                    ++next;
+                if (next < 256)
+                {
+                    m.index = next;
+                    used[static_cast<size_t>(next)] = true;
+                }
+            }
+        }
+        startingPoints_ = kept;
+        startingPoints_.insert(startingPoints_.end(), mirrored.begin(), mirrored.end());
+    }
+
+    // waypoints_ is left alone on purpose: the writer derives [Header] Waypoint1..8
+    // from startingPoints_, so this table is not what gets written, and it is a
+    // per-cell one whose symmetry follows the shape the early pass already made
+    // symmetric.
+
+    // ---- the corridor overlays, which are NOT mirrored -------------------
+    //
+    // LinkSameLevelRegions draws its strip with orientation-specific overlays:
+    // 94 / 92 / 74 + (x % 4) with OverlayData = the distance from the near edge
+    // for a horizontal corridor, and 96 / 98 / 83 + (y % 4) for a vertical one
+    // (MapGenMakingSub.cpp, the comment above LinkSameLevelRegions).  A mirror
+    // turns one into the other, so those cells would need their family swapped -
+    // not merely their cell moved - and that transform is NOT implemented.
+    //
+    // It is not implemented because it cannot be tested: measured over 180
+    // generated maps (sizes 0/1/2/3/3.6 x players 2/4/8 x land 0/2/3/4 x three
+    // seeds), 162202 overlaid cells, 34 distinct overlay indices spanning 27..177
+    // - NONE fell in [74,98].  The function IS reachable (it is called from
+    // MapGenMakingSub.cpp:1305), so this is "not observed", not "dead", and writing
+    // an untestable transform is what this project forbids.  Making the assumption
+    // detectable is the alternative: tools/verify_symmetry.py fails if a generated
+    // map ever carries one.
+    std::fprintf(stderr,
+                 "[symmetry] placed: %s, %zu start points, %zu waypoints, %zu terrain "
+                 "objects, %zu structures (the overlay layer is reported by "
+                 "MirrorOverlays above)\n",
+                 mg::MapSymmetryName(kind), startingPoints_.size(),
+                 waypoints_.size(), terrainObjects_.size(), structures_.size());
+    return true;
+}
+
+// ===========================================================================
+// MirrorSpecialTerrain - Inland / Mountainous (LandType 3/4).
+//
+// These two land types never run GenerateTerrain: the base is land already (nothing
+// floods the map with water) and the terrain comes from GenerateSpecialTerrain, which
+// carves a river and then lakes into it.  Measured on the finished map before this
+// existed: the pass' shape mirror never ran at all (it lives inside GenerateTerrain) and
+// the outline scored 0.961 - which is the chance level for a map that is almost all
+// land, and identical to the same map generated with symmetry off.
+//
+// Two differences from the Continent path decide what has to happen here:
+//   * the carving stamps its ART as it goes (river shores, the cliff banks along them)
+//     instead of leaving it to a later stage, so mirroring only the shape would leave
+//     the water in mirrored places and its banks where they were carved;
+//   * it cannot run before the carving: GenerateSpecialTerrain starts from whatever the
+//     cells already hold, so there is no "shape is complete, art has not started" moment
+//     to hook into.
+// So the cells are copied whole - payload AND art - with the multi-cell pieces turned
+// into their mirrored pieces (MirrorTile) and SlopeIndex reflected, and then
+// RecalculateCellAttributes() re-derives the neighbour-dependent art (LAT masks, ramp
+// smoothing) from the now-symmetric cells.  On this land type the ground is a uniform
+// fill, which is the condition under which copying finished art is safe: on Continent
+// the same copy was measured at 1.38% dark pixels because the ground art varies per
+// cell, and here the per-stage check on the rendered image is what decides.
+//
+// The driver calls this after GenerateSpecialTerrain returns (that function has an early
+// return on a successful lake, so it cannot host the call itself).
+// ===========================================================================
+bool RandomMapGenerator::MirrorSpecialTerrain(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorSpecialTerrain: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && kind != mg::MapSymmetry::Rotational180)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorSpecialTerrain: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+
+    long long cells = 0, turned = 0, approximated = 0, shoreKept = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;
+            if (!(x < mx || (x == mx && y < my)))
+                continue;                           // `a` is the authoritative side
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                std::fprintf(stderr, "[symmetry] MirrorSpecialTerrain: mirrored pair "
+                             "(%d,%d) has no cell on the other side\n", x, y);
+                return false;
+            }
+            int tile = a->IsoTileTypeIndex;
+            int height = a->Height;
+            bool approx = false;
+            // [移植侧] 岸族交还给生成器自己的镜像感知选择：SelectShoreTile 已让镜像半场用
+            // 镜像伙伴那一格的 roll 走同一棵官方决策树，选出来的片就是"同一随机输入下的对应
+            // 输出"（形状与变体都对应）。这里若再按"形状转置"覆盖一次，反而打散那份对应关系
+            // —— 实测两者同时开着时，roll 共享对最终图完全没有影响。
+            // （先前那次 A/B 结论是"交还更差"，但那时 roll 没有共享，镜像侧是另一次独立抽签。）
+            const bool isShore = shorePieces_ >= 0
+                && tile >= shorePieces_ && tile < shorePieces_ + 42;
+            const int partner = isShore ? -1 : MirrorTile(tile, kind, &height, &approx);
+            if (partner >= 0)
+            {
+                tile = partner;
+                ++turned;
+                if (approx)
+                    ++approximated;
+            }
+            else if (isShore)
+            {
+                // [移植侧] 岸格：片号保留生成器的镜像感知选择；片内偏移的镜像转置**不在这里做**
+                // —— 实测这道 pass 之后还有岸片盖章会把它按片内格号重算回去（dbg：写 3 -> 落盘前 1）。
+                // 所以偏移转置放到最后一道 pass（MirrorMap）里做。见那里的注释。
+                ++shoreKept;
+            }
+            b->IsoTileTypeIndex = tile;
+            b->Height = height;
+            b->Level = a->Level;
+            b->SlopeIndex = mg::ReflectSlope(kind, a->SlopeIndex);
+            b->LandType = a->LandType;
+            b->Passability = a->Passability;
+            b->TubeIndex = a->TubeIndex;
+            b->ZAdjust = a->ZAdjust;
+            b->CellFlags = a->CellFlags;
+            ++cells;
+        }
+    }
+
+    // The neighbour-dependent art (LAT masks, ramp smoothing) is deliberately NOT
+    // re-derived here.  It was, and measurement said not to: the copy above is exact
+    // (0 mirrored pairs disagree on the land/water marker), while calling
+    // RecalculateCellAttributes() inside this pass left 492 of 6952 pairs differing in
+    // their tiles and 394 with a different Height, against 394 / 197 without it.  That
+    // function is deterministic (MapGenRecalc.cpp draws no RNG) but NOT mirror-
+    // equivariant: it walks the cells once and later cells read neighbours it has
+    // already rewritten.  The pipeline calls it four more times further on anyway, so
+    // dropping it here loses nothing and keeps the state as close to symmetric as
+    // possible.
+
+    // Report, and check the result against itself - the rendered map cannot tell
+    // whether a shape mirror worked (an unmirrored map scores 0.961 here by itself).
+    long long pairs = 0, disagree = 0, water = 0, land = 0, other = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            const bool aw = IsWaterTile(a);
+            if (aw) ++water;
+            else if (a->IsoTileTypeIndex == 0) ++land;
+            else ++other;
+
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;
+            if (!(x < mx || (x == mx && y < my)))
+                continue;
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+                continue;
+            ++pairs;
+            if (aw != IsWaterTile(b))
+                ++disagree;
+        }
+    }
+    std::fprintf(stderr,
+                 "[symmetry] special: %s, copied %lld cell pairs whole, %lld art pieces "
+                 "turned (%lld of them to a best-approximation piece - the tileset has no "
+                 "exact mirrored partner for those; %llu coast pieces chosen by the measured "
+                 "water-direction table, %llu of them by the style preference); %lld shore tiles left "
+                 "to the generator's own mirror-aware decision; self-check "
+                 "%lld pairs, %lld disagree "
+                 "about water (water=%lld land=%lld other=%lld)\n",
+                 mg::MapSymmetryName(kind), cells, turned, approximated,
+                 MgShoreProfilePicked(), MgShoreStyleFallback(), shoreKept, pairs, disagree,
+                 water, land, other);
+    return disagree == 0;
+}
