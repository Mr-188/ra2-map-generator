+// ===========================================================================
+// MirrorLevels - the elevation field only, for the window inside MakeRegions
+// where the levels have been assigned but no art depends on them yet.
+//
+// RebuildRegionBodies and ReseedRegions assign the elevation, and they are driven by a
+// randomised region growth: the region's seed CELL is drawn at random, its heading is
+// drawn at random, the split target is drawn at random and (for large regions) the level
+// is picked from a candidate list at random.  The two halves therefore run two DIFFERENT
+// growths.  Measured: sharing the growth's priority draw per mirrored pair made it worse
+// (MakeRegions went from 1378 to 2159 disagreeing pairs), because pairing values across
+// two unrelated growths is meaningless - so this term cannot be fixed by sharing draws.
+//
+// What CAN be done is to even out the result, and the window matters: everything that
+// turns a level into art (FixCliffLevels, PlaceCliffs, CorrectCliffTiles, CreateHills,
+// CreateLATs, RecalculateCellAttributes) runs AFTER these two functions.  Copying the
+// level field here therefore gives those stages a symmetric input and lets them choose
+// symmetric art themselves.  Doing the same copy at the END of the pipeline is what was
+// tried and rejected before: by then the art is already chosen for the other half's
+// heights, and the render went from 0.39% to 3.31% dark pixels.
+//
+// With symmetry off this returns immediately, so the vanilla path does not change.
+// ===========================================================================
+bool RandomMapGenerator::MirrorLevels(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorLevels: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && kind != mg::MapSymmetry::Rotational180)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorLevels: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    long long pairs = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(size_.mapWidth, size_.mapHeight, kind, x, y, &mx, &my))
+                continue;
+            if (!(x < mx || (x == mx && y < my)))
+                continue;                           // `a` is the authoritative side
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                std::fprintf(stderr, "[symmetry] MirrorLevels: mirrored pair (%d,%d) has "
+                             "no cell on the other side\n", x, y);
+                return false;
+            }
+            b->Level = a->Level;
+            ++pairs;
+        }
+    }
+    std::fprintf(stderr, "[symmetry] levels: %s, copied the elevation of %lld cell "
+                 "pairs before any art was chosen for it\n",
+                 mg::MapSymmetryName(kind), pairs);
+    return true;
+}
+
+// ===========================================================================
+// MirrorOverlays - the overlay layer and the building flag, copied from the
+// authoritative half onto its image.  Called twice by design:
+//   * by the driver right after AddTiberium and BEFORE CreateHills.  Not cosmetic: the
+//     ore and the tech buildings are placed with RNG, so until they are evened out the
+//     two halves differ in exactly the fields CanHostSlope() reads
+//     (OverlayTypeIndex != -1 and AltFlags & ContainsBuilding), and CreateHills'
+//     FinalizeElevationSlopes skips its level update wherever that test fails - which is
+//     where its measured 1216 mirrored pairs with a different Level came from.
+//   * by MirrorMap at the end, so anything placed after that point is evened out too.
+// Ore overlays carry no orientation (a random 0..11 variant plus a growth counter), so
+// moving them verbatim is exact - unlike tiles, which is why tiles are not touched.
+// ===========================================================================
+bool RandomMapGenerator::MirrorOverlays(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorOverlays: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && kind != mg::MapSymmetry::Rotational180)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorOverlays: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+    long long overlays = 0, unpaired = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;
+            if (!(x < mx || (x == mx && y < my)))
+                continue;                           // `a` is the authoritative side
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                ++unpaired;
+                continue;
+            }
+            b->OverlayTypeIndex = a->OverlayTypeIndex;
+            b->OverlayData = a->OverlayData;
+            b->AltFlags = a->AltFlags;
+            if (a->OverlayTypeIndex >= 0)
+                ++overlays;
+        }
+    }
+    if (unpaired > 0)
+    {
+        std::fprintf(stderr, "[symmetry] WARNING: MirrorOverlays found %lld mirrored "
+                     "pairs with no slot on one side\n", unpaired);
+        return false;
+    }
+    std::fprintf(stderr, "[symmetry] overlays: %s, %lld overlay pairs and their building "
+                 "flags evened out\n", mg::MapSymmetryName(kind), overlays);
+    return true;
+}
