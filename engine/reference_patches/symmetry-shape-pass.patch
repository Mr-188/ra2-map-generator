+static unsigned char MirrorWaterProfile(unsigned char m)
+{
+    static const int perm[8] = { 6, 5, 4, 3, 2, 1, 0, 7 };
+    unsigned char o = 0;
+    for (int i = 0; i < 8; ++i)
+        if ((m >> i) & 1)
+            o |= static_cast<unsigned char>(1u << perm[i]);
+    return o;
+}
+
+// ---------------------------------------------------------------------------
+// [移植侧] 风格偏好表：水向吻合的候选往往不止一个，取哪一个？
+// 出处（实测）：对每片先筛"足印转置 + 水向吻合"的全部候选，再用渲染接近度
+// |渲染(P) − 水平翻转(渲染(Q))| 挑最像的（图库 28 片两两矩阵）。实测平均 36.9 -> 32.4
+// （省 12%：片 39 省 20.6、32 省 16.6、40 省 16.0、31 省 15.9）。0 = 无偏好。
+// ---------------------------------------------------------------------------
+static const unsigned char kShoreMirrorPreference[43] = {
+     0,  0,  3,  2,  0,  0,  0,  0, 33,
+    32, 27, 27,  0,  0,  0, 31, 24, 25,
+    19, 18,  0,  0,  0,  0, 16, 17, 10,
+    10,  0,  0,  0, 15,  8,  8, 40, 40,
+    39, 39, 37, 37, 34,  0,  0,
+};
+
+// 按信息表（而不是"第一个匹配"）挑中对称件的次数 —— 失败/降级要看得见。
+static unsigned long long g_shoreProfilePicked = 0;
+static unsigned long long g_shoreStyleFallback = 0;
+unsigned long long MgShoreProfilePicked() { return g_shoreProfilePicked; }
+unsigned long long MgShoreStyleFallback() { return g_shoreStyleFallback; }
+
+RandomMapGenerator::TileSets RandomMapGenerator::GetTileSets() const
+{
+    TileSets s;
+    s.water        = waterTileIndex_;
+    s.shorePieces  = shorePieces_;
+    s.shoreTile    = shoreTileIndex_;
+    s.waterCliffs  = waterCliffsIndex_;
+    s.greenTile    = greenTileIndex_;
+    s.roughTile    = roughTileIndex_;
+    s.sandTile     = sandTileIndex_;
+    s.rampBase     = rampBaseIndex_;
+    s.rampSmooth   = rampSmoothIndex_;
+    return s;
+}
+
+// ---------------------------------------------------------------------------
+// [移植侧] 180 的斜坡方向映射。
+//
+// 斜坡族（INI [General] RampBase -> TileSet "slope"，20 片）的片号与坡向一一对应：
+// `MapGen.h:1452` 与 `MapGenHills.cpp:1158` 都写着  tile = rampBaseIndex_ + SlopeIndex - 1，
+// 而坡向按 4 个一组轮转（`MergeSlopeBlocks` 合并的是"5/6/7/8 或 11/12/9/10"，后者写成
+// 11/12/9/10 正是 +2 循环）。所以 180° = 组内 +2：1↔3, 2↔4 | 5↔7, 6↔8 | 9↔11, 10↔12 | …
+// 与 ReflectSlope 已有的 1↔3 / 2↔4 一致（它只覆盖四个角坡）。
+//
+// 为什么单独做：斜坡片基本都是 1×1，MirrorTile 对 1×1 一律 `return -1`，五个族里也没有
+// 斜坡族 → 180 下整族不映射（实测一张内陆图 1954 个斜坡格中 96 格"自己配自己"、14 个源片
+// 全部配到多个伙伴，甚至配到平地）。LR 靠 MirrorDivergedCells 整格抄就对（左右对称是 8
+// 邻域自同构），180 不行（对角互换，实测暗像素 0.45%→3.58%），必须按坡向重新选片。
+// 只在 180 生效，LR / 上下对称不动。
+
+int RandomMapGenerator::MirrorTile(int tile, mg::MapSymmetry kind, int* inoutHeight,
+                                   bool* approximate, bool* styleFallback) const
+{
+    // The five multi-cell families.  kWaterfallFootprints is [4][4] and each row
+    // is contiguous, so each compass family is its own run - a mirrored waterfall
+    // can land in a different compass family, so the search spans all of them.
+    struct Run { const IsoFootprint* table; int base; int count; };
+    Run runs[8];
+    int n = 0;
+    if (shorePieces_ >= 0)            runs[n++] = { kShoreFootprints,            shorePieces_,            42 };
+    if (shoreTileIndex_ >= 0)         runs[n++] = { kCliffFootprints,            shoreTileIndex_,         40 };
+    if (waterCliffsIndex_ >= 0)       runs[n++] = { kCliffWaterFootprints,       waterCliffsIndex_,       28 };
+    if (destroyableCliffsIndex_ >= 0) runs[n++] = { kDestroyableCliffFootprints, destroyableCliffsIndex_,  2 };
+    for (int f = 0; f < 4; ++f)
+        if (waterFamily4Base_[f] >= 0) runs[n++] = { kWaterfallFootprints[f],    waterFamily4Base_[f],     4 };
+
+    // Which family is this tile in?
+    const IsoFootprint* fp = nullptr;
+    int ownRun = -1;
+    for (int i = 0; i < n && fp == nullptr; ++i)
+    {
+        const Run& r = runs[i];
+        if (tile >= r.base && tile < r.base + r.count)
+        {
+            fp = &r.table[tile - r.base];
+            ownRun = i;
+        }
+    }
+    if (fp == nullptr)
+        return -1;
+
+    const int w = fp->w, h = fp->h;
+    if (w * h <= 1)
+        return -1;                                  // a single 1x1 piece
+    // [移植侧] 白名单必须用 IsRotation180：写死 Rotational180 时，180 的另一种半场
+    // (Rotational180Alt) 会在这里直接吃 -1 = "无对应件"，于是**镜像半场的岸件一片都不
+    // 被转向**（MirrorSpecialTerrain 的 turned 计数实测 0，而 180 是 270）—— 渲染出来
+    // 就是镜像半场那片湖没有绿色湖岸裙边、只剩硬锯齿边（用户实测）。
+    if (kind != mg::MapSymmetry::AxialLeftRight && !mg::IsRotation180(kind)
+        && kind != mg::MapSymmetry::AxialTopBottom)
+        return -1;
+
+    // [移植侧] 每种对称有自己的足印变换：左右=转置；180=旋转 180；上下=反对角翻转。
+    const bool transpose = (kind == mg::MapSymmetry::AxialLeftRight);
+    const bool topbottom = (kind == mg::MapSymmetry::AxialTopBottom);
+    const int tw = (transpose || topbottom) ? h : w;    // the mirrored footprint
+    const int th = (transpose || topbottom) ? w : h;
+
+    unsigned long long tmask = 0;
+    for (int row = 0; row < h; ++row)
+    {
+        for (int col = 0; col < w; ++col)
+        {
+            if (((fp->mask >> (row * w + col)) & 1ULL) == 0)
+                continue;
+            int nr, nc;
+            if (transpose)      { nr = col;         nc = row; }
+            else if (topbottom) { nr = w - 1 - col; nc = h - 1 - row; }
+            else                { nr = h - 1 - row; nc = w - 1 - col; }
+            tmask |= 1ULL << (nr * tw + nc);
+        }
+    }
+
+    // Find a piece with that mirrored footprint IN THE SAME FAMILY.  Staying
+    // inside the family is not an optimisation: a CliffSet piece and a ShorePieces
+    // piece can share a footprint exactly, and matching across them swaps a cliff
+    // for a beach.  Measured before this was restricted: the decoded kind
+    // distribution moved 474 cells from terrain to shore.
+        // [移植侧] 对称：同族里若有多片共用这个转置足印，先按"外围水向"挑、再按风格偏好二级挑。
+    // [移植侧/修差一] 这里原来是 `tile > shorePieces_`，把岸族的**第一片**（tile == 基址，
+    // 也就是 Shore01.tem）排除在剖面搜索之外 —— 于是 #1 落到下面"取表里第一个同足印件"的
+    // 通用回退，镜像侧写成 #2（用户实测"01 的镜像本该是 17/18/19，结果放了 02"）。
+    // 同样的差一让候选筛选把 #1 也排除，于是 #17 只能配到 #2。改成 >= / <。
+    if (shorePieces_ >= 0 && tile >= shorePieces_ && tile < shorePieces_ + 43)
+    {
+        const int srcIdx = tile - shorePieces_ + 1;
+        const unsigned char srcProf = kShoreWaterProfile[srcIdx];
+        if (srcProf != 0)
+        {
+            // [移植侧] 修正：180 必须用 180 的剖面置换。之前这里无论 kind 都用转置的
+            // MirrorWaterProfile，于是 180 挑出的"对应件"足印对、朝向错 —— 镜像侧岸线走样
+            // 的根源。数据层核对：42 片里 38 片存在"足印+剖面都对"的 180 对应件。
+            const bool rot180 = mg::IsRotation180(kind);
+            const unsigned char want = rot180 ? Rot180WaterProfile(srcProf)
+                                              : MirrorWaterProfile(srcProf);
+            // [移植侧] 180 试过"按候选集分组、组内同序对应"的配对表（从表的等距平移结构推出来），
+            // **实测没有改善**（#34↔#38 的水面掩膜 IoU 仍 0.01、整图中位 0.423→0.424、肉眼 A/B 无差别），
+            // 已撤回：那套指标对多格件不可靠，没有可靠测量就不改。180 这里保持"无偏好 → firstCand"。
+            const int prefer = rot180 ? 0 : kShoreMirrorPreference[srcIdx];
+            int firstCand = -1, prefCand = -1;
+            for (int k = 0; k < runs[ownRun].count; ++k)
+            {
+                const IsoFootprint& g = runs[ownRun].table[k];
+                if (g.w != tw || g.h != th || g.mask != tmask)
+                    continue;
+                const int cand = runs[ownRun].base + k;
+                if (cand < shorePieces_ || cand >= shorePieces_ + 43)
+                    continue;
+                if (kShoreWaterProfile[cand - shorePieces_ + 1] != want)
+                {
+                    // [移植侧] 180：这里曾经加过一条"没有精确对应件就取剖面最近的候选"
+                    // 的替换（针对 42 片里唯一没有 180 伙伴的 #4/#20）。**已实测否决并撤掉**：
+                    // 那两片互为最近件但并不互为 180 旋转（同格实例的水掩膜 IoU 只有
+                    // 0.31~0.43），替换之后镜像侧画出一块硬边的矩形沙滩，用户一眼就看出来了；
+                    // 撤掉之前（保留生成器自己选的片）那一处是正常的。教训：宁可留一条
+                    // "此处无法镜像"的差异，也不要用一片朝向不对的岸件去填。
+                    continue;
+                }
+                if (firstCand < 0)
+                    firstCand = cand;
+                if (prefer != 0 && cand - shorePieces_ + 1 == prefer)
+                {
+                    prefCand = cand;
+                    break;
+                }
+            }
+            int chosen = (prefCand >= 0) ? prefCand : firstCand;
+            // **实测记录（2026-10-12）**：用户看素材判定 Shore04.tem 与 Shore20.tem 互为 180
+            // 对称件，这一条已验证成立 —— 而且**引擎本来就把它们配成对**：剖面搜索失败后走下面
+            // 的通用回退（同足印、不看剖面），实测一张图上镜像对就是 (4,20)×8 与 (20,4)×8，
+            // 偏移也按 180 正确重映射（generic 路径里的 moved 计算）。我曾经在这里加过"强制
+            // 配对"的补丁，结果**什么都不改变**（配对/IoU/渲染全同），已删除。
+            // 那两格视觉上的硬边因此不是配对问题，而是"这两片自身的美术在两侧被画成不同样子"
+            // （待查：两侧格子的 z/height 是否一致）。
+            // 精确对应件不存在时**什么都不换**（返回 -1，调用方保留生成器自己选的片）。
+            // 42 片里只有 #4/#20 会走到这里；见上面撤掉那次替换的原因。
+            if (chosen >= 0)
+            {
+                if (inoutHeight != nullptr)
+                {
+                    const int off = *inoutHeight;
+                    if (off < 0 || off >= w * h)
+                        return -1;
+                    const int row = off / w, col = off % w;
+                    int moved;
+                    if (transpose)      moved = col * h + row;
+                    else if (topbottom) moved = (w - 1 - col) * h + (h - 1 - row);
+                    else                moved = (h - 1 - row) * w + (w - 1 - col);
+                    if (((tmask >> moved) & 1ULL) == 0)
+                        return -1;
+                    *inoutHeight = moved;
+                }
+                ++g_shoreProfilePicked;
+                if (prefCand < 0 && prefer != 0)
+                {
+                    ++g_shoreStyleFallback;
+                    if (styleFallback != nullptr)
+                        *styleFallback = true;
+                }
+                return chosen;
+            }
+        }
+    }
+
+    const Run& r = runs[ownRun];
+    for (int k = 0; k < r.count; ++k)
+    {
+        const IsoFootprint& g = r.table[k];
+        if (g.w != tw || g.h != th || g.mask != tmask)
+            continue;
+        // [移植侧] 180：**跳过源片自己**。这条回退是"剖面搜索失败"后的兜底（同足印、不看
+        // 剖面），它按表序返回第一个同足印件 —— 而 1×2 里第一个永远是 #4，于是 #4 的镜像格
+        // 又拿到 #4（等于没换，用户看到的就是"另一边仍然放着 04"）。跳过自己之后 #4 只能落到
+        // #20、#20 落到 #4 —— 正是用户看素材判断的对称关系（Shore04.tem ↔ Shore20.tem）。
+        // 只对 180 生效：LR 的既有基线（实测 0.967）不动，这条留给单独验证。
+        // 只在岸族里跳过自己：通用回退是所有族共用的，崖/瀑布那些族没有验证过，
+        // 不在这里顺手改（它们的"自己配自己"另开一次验证）。
+        if (mg::IsRotation180(kind) && shorePieces_ >= 0
+            && r.base == shorePieces_ && r.base + k == tile)
+            continue;
+
+        if (inoutHeight != nullptr)
+        {
+            const int idx = *inoutHeight;
+            if (idx < 0 || idx >= w * h)
+                return -1;                      // not an in-footprint offset
+            const int row = idx / w;
+            const int col = idx % w;
+            int moved;
+            if (transpose)      moved = col * h + row;
+            else if (topbottom) moved = (w - 1 - col) * h + (h - 1 - row);
+            else                moved = (h - 1 - row) * w + (w - 1 - col);
+            // The remapped offset must land on a cell the partner really
+            // occupies, or the piece would end up with a hole in it.
+            if (((tmask >> moved) & 1ULL) == 0)
+                return -1;
+            *inoutHeight = moved;
+        }
+        return r.base + k;
+    }
+    return -1;                                      // this family is not closed under `kind`
+}
