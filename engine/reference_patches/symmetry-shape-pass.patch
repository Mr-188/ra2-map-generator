+// ===========================================================================
+// MirrorElevationGrid - the scratch elevation grid, mirrored by transposing it.
+//
+// The grid is square (side == rows, elevLeft_ == elevTop_ == 0) and grid point (gx, gy)
+// belongs to the map cell of the same coordinates, so the left-right mirror of the grid
+// is its transpose.  Its seed is 15 * cell->Level + off_83FF18[cell->SlopeIndex][0], and
+// SlopeIndex is an ORIENTATION code - the two halves carry mirrored codes - so without
+// this the grids differ, FinalizeElevationSlopes' "lowest corner / 15" differs, and the
+// elevation it writes differs.
+//
+// Called twice on purpose: once after BuildElevationGrid (so ApplyElevationLevels reads
+// symmetric corners) and once after ApplyElevationLevels (which sets the corners and the
+// touched flags itself - measured: 142 of 6952 pairs had a different touched flag until
+// this second call existed).
+//
+// Left-right only: the 180-degree rotation would need its own mapping over this
+// rectangle and has not been measured.  With symmetry off nothing happens.
+// ===========================================================================
+void RandomMapGenerator::MirrorElevationGrid()
+{
+    const int side = size_.workSide;
+    if (config_.symmetry != mg::MapSymmetry::AxialLeftRight || side <= 0
+        || elevStride_ != side
+        || elevGrid_.size() < static_cast<size_t>(side) * static_cast<size_t>(side))
+        return;
+
+    for (int gy = 0; gy < side; ++gy)
+    {
+        for (int gx = gy + 1; gx < side; ++gx)
+        {
+            const ElevationEntry& src = elevGrid_[gy + elevStride_ * gx];
+            ElevationEntry& dst = elevGrid_[gx + elevStride_ * gy];
+            dst.corner = src.corner;
+            dst.blocked = src.blocked;
+            dst.touched = src.touched;
+        }
+    }
+
+}
+
+// ===========================================================================
+// MirrorWorkMarks - the two protection marks the hill stage sets for itself.
+//
+// CanHostSlope reads WorkAt(x,y).Byte(69), and CliffMask reads Byte(74).  MarkHillProtection
+// and MarkTechBuildingProtection set them from what they see around a cell, and what they
+// see includes the tile indices - which are MIRRORED on the two halves, not equal.  So the
+// marks come out different, CanHostSlope answers differently, and FinalizeElevationSlopes
+// then updates the elevation on one side only: measured 369 of 6952 mirrored pairs with a
+// different CanHostSlope() answer.  Copying the canonical half's marks over is the same
+// move as MirrorLevels, one field narrower.
+// ===========================================================================
+bool RandomMapGenerator::MirrorWorkMarks(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr || workCells_ == nullptr)
+        return true;
+    if (kind != mg::MapSymmetry::AxialLeftRight && !mg::IsRotation180(kind)
+        && kind != mg::MapSymmetry::AxialTopBottom)
+        return false;
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+    long long pairs = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;
+            if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                continue;
+            WorkCell& src = WorkAt(static_cast<int16_t>(x), static_cast<int16_t>(y));
+            WorkCell& dst = WorkAt(static_cast<int16_t>(mx), static_cast<int16_t>(my));
+            dst.Byte(69) = src.Byte(69);
+            dst.Byte(74) = src.Byte(74);
+            ++pairs;
+        }
+    }
+    std::fprintf(stderr, "[symmetry] marks: %s, %lld cell pairs' protection marks "
+                 "evened out\n", mg::MapSymmetryName(kind), pairs);
+    return true;
+}
