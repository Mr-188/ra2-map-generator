+double RandomMapGenerator::MirrorSharedValue(double own, const MapCell* c, int site)
+{
+    if (config_.symmetry == mg::MapSymmetry::None || c == nullptr)
+        return own;
+    const int rx = c->MapCoords & 0xFFFF;
+    const int ry = static_cast<uint32_t>(c->MapCoords) >> 16;
+    int mx = 0, my = 0;
+    if (!mg::MirrorCell(size_.mapWidth, size_.mapHeight, config_.symmetry, rx, ry, &mx, &my))
+        return own;
+    const bool canonical = (rx < mx || (rx == mx && ry < my));
+    const unsigned long long key =
+        static_cast<unsigned long long>(canonical ? rx : mx)
+      | (static_cast<unsigned long long>(canonical ? ry : my) << 16)
+      | (static_cast<unsigned long long>(static_cast<unsigned>(site) + 1) << 32);
+    if (canonical)
+    {
+        sharedDraws_[key] = own;
+        return own;
+    }
+    const std::map<unsigned long long, double>::const_iterator it = sharedDraws_.find(key);
+    return (it != sharedDraws_.end()) ? it->second : own;
+}
