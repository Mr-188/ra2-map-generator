+
+// DirType under a mirror.  The mirror transforms a direction vector (dx, dy) the
+// same way it transforms a cell offset, so taking the engine's own neighbour order
+// (MapGenMakingSub.cpp kDirX/kDirY: 0 N(0,-1) 1 NE(1,-1) 2 E(1,0) 3 SE(1,1)
+// 4 S(0,1) 5 SW(-1,1) 6 W(-1,0) 7 NW(-1,-1)):
+//   left-right  (dx,dy)->(dy,dx)     N<->W, NE<->SW, E<->S, SE and NW fixed
+//   180 degrees (dx,dy)->(-dx,-dy)   every direction moves by four
+// Derived from that table, not from a guess.
+const int kFacingLeftRight[8] = { 6, 5, 4, 3, 2, 1, 0, 7 };
+
+inline int MirrorFacing(mg::MapSymmetry kind, int facing)
+{
+    if (facing < 0 || facing > 7)
+        return facing;
+    if (kind == mg::MapSymmetry::AxialLeftRight)
+        return kFacingLeftRight[facing];
+    return (facing + 4) & 7;
+}
+
+// A cheap summary of the finished tiles, used only to report what a pass changed.
+// It is not a checksum anything else should depend on - the acceptance suite
+// compares decoded maps and rendered images instead.
+inline long long TileSummary(const MapCell* const* slots, int rows)
+{
+    unsigned long long h = 1469598103934665603ULL;
+    for (int y = 0; y < rows; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            const MapCell* c = slots[512 * y + x];
+            if (c == nullptr)
+                continue;
+            h ^= static_cast<unsigned long long>(c->IsoTileTypeIndex) * 1099511628211ULL;
+            h ^= static_cast<unsigned long long>(c->Height) * 1099511628211ULL;
+            h *= 1099511628211ULL;
+        }
+    }
+    return static_cast<long long>(h);
+}
+
+}  // namespace
+
+// ===========================================================================
+// MirrorShape - the shape, before any art is chosen for it.
+//
+// What the shape consists of at this point was read off GenerateMapBody
+// (MapGen.cpp:697): it marks every cell with waterTileIndex_, grows the land with
+// GenerateArchipelago/GenerateContinent/GenerateTeamContinent, smooths the water
+// and clears the work array.  So the shape after it is exactly
+//   * IsoTileTypeIndex  the land/water mark (waterTileIndex_ = water)
+//   * Level             the elevation
+//   * Height            zero on everything the shape stage touched
+// and ClearWorkOccupancy() has already wiped workCells_, so nothing there needs
+// mirroring.
+//
+// The shape stage also leaves ShorePieces along the coast in some paths (see the
+// rollback branch that zeroes them), and those are real art with an orientation.
+// They are put through MirrorTile as well, so whether the later stages overwrite
+// them or not, nothing orientation-bearing is left facing the old way.
+// ===========================================================================
+bool RandomMapGenerator::MirrorShape(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorShape: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && !mg::IsRotation180(kind)
+        && kind != mg::MapSymmetry::AxialTopBottom)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorShape: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+
+    // Both kinds are involutions of the diamond, so each pair is acted on once:
+    // only the half that sorts before its own image is swapped.
+    long long swapped = 0, unpaired = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;                           // not a cell of the diamond
+            if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                continue;                           // its image handles this pair
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                // MirrorCell says the image is a cell, so its slot must hold one.
+                ++unpaired;
+                continue;
+            }
+            // COPY, not swap.  Swapping a pair produces the MIRROR IMAGE of the
+            // map, which is not a symmetric map at all: the operation preserves
+            // whether the two cells agreed, so a pair that disagreed still
+            // disagrees.  Measured: with the swap, 802 of 6460 pairs disagreed
+            // about "is this water" after the pass - and an UNMIRRORED map scores
+            // the same 0.877 on water/land self-symmetry, so the swap was doing
+            // nothing at all.  A symmetric map needs the authoritative half copied
+            // onto its image.
+            b->IsoTileTypeIndex = a->IsoTileTypeIndex;
+            b->Level = a->Level;
+            b->Height = a->Height;
+
+            ++swapped;
+        }
+    }
+    if (unpaired > 0)
+    {
+        std::fprintf(stderr, "[symmetry] WARNING: MirrorShape found %lld mirrored "
+                     "pairs with no slot on one side; the shape is only partly "
+                     "mirrored\n", unpaired);
+        return false;
+    }
+
+    // Orientation-bearing marks that came with the shape (the coast's shore
+    // pieces).  MirrorTile answers -1 for anything that is not a multi-cell family
+    // member - which the plain land/water mark is - and for a family member with
+    // no counterpart, which is counted so it cannot pass unnoticed.
+    long long pieces = 0, turned = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* c = cellSlots_[512 * y + x];
+            if (c == nullptr)
+                continue;
+            int cols = 0, rows = 0;
+            if (!TileFootprint(c->IsoTileTypeIndex, &cols, &rows) || cols * rows <= 1)
+                continue;
+            ++pieces;
+            int height = c->Height;
+            const int partner = MirrorTile(c->IsoTileTypeIndex, kind, &height);
+            if (partner < 0)
+                continue;
+            c->IsoTileTypeIndex = partner;
+            c->Height = height;
+            ++turned;
+        }
+    }
+
+    std::fprintf(stderr,
+                 "[symmetry] shape: %s, copied %lld cell pairs onto their images, %lld/%lld "
+                 "orientation-bearing shape pieces turned\n",
+                 mg::MapSymmetryName(kind), swapped, turned, pieces);
+
+    // ---- the pass measured against itself --------------------------------
+    //
+    // The rendered map cannot tell whether a shape mirror worked: measured on this
+    // generator, an UNMIRRORED map scores 0.877 on water/land self-symmetry all by
+    // itself, which is exactly what a mirrored one scored while this pass was doing
+    // nothing useful.  So the pass reports its own result instead, over the whole
+    // diamond: how many mirrored pairs disagree about "is this water", plus how
+    // many cells carry the water mark, the land mark and something else.  A working
+    // mirror has to report 0 disagreeing pairs here.
+    {
+        long long disagree = 0, pairs = 0, water = 0, land = 0, other = 0;
+        for (int y = 0; y < slotRows_; ++y)
+        {
+            for (int x = 0; x < 512; ++x)
+            {
+                MapCell* a = cellSlots_[512 * y + x];
+                if (a == nullptr)
+                    continue;
+                if (a->IsoTileTypeIndex == waterTileIndex_) ++water;
+                else if (a->IsoTileTypeIndex == 0) ++land;
+                else ++other;
+
+                int mx = 0, my = 0;
+                if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                    continue;
+                if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                    continue;
+                MapCell* b = cellSlots_[512 * my + mx];
+                if (b == nullptr)
+                    continue;
+                ++pairs;
+                if ((a->IsoTileTypeIndex == waterTileIndex_)
+                    != (b->IsoTileTypeIndex == waterTileIndex_))
+                    ++disagree;
+            }
+        }
+        std::fprintf(stderr,
+                     "[symmetry] shape self-check: %lld mirrored pairs, %lld disagree "
+                     "about water; cells: water=%lld land=%lld other=%lld\n",
+                     pairs, disagree, water, land, other);
+    }
+    return true;
+}
+
+// ===========================================================================
+// MirrorMap - what is PLACED, after the shape has already been mirrored.
+//
+// The overlay layer: AddTiberium and the tech buildings run after MirrorShape, so
+// the ore sits wherever the generator put it on the mirrored shape and has to be
+// reflected for the two halves to match.  Ore overlays carry no orientation (a
+// random 0..11 variant plus a growth counter, MapGenTiberium.cpp), so moving them
+// verbatim is exact - and it is the reason this pass must not touch the tiles,
+// which are the thing that cannot be moved.
+//
+// The four ledgers: startingPoints_ (and therefore [Waypoints] and the
+// single-player HomeCell/AltHomeCell fields the writer derives from
+// startingPoints_[0].index), waypoints_, the terrain objects and the structures -
+// the latter with `facing` mapped too.
+//
+// NOT mirrored, deliberately:
+//   * IsoTileTypeIndex / Height / Level - the shape was mirrored before the art was
+//     chosen for it; moving them again would undo exactly what makes the render
+//     correct.  This is the whole point of the two-phase split.
+//   * SlopeIndex - it drives the ramp art (MapGenRecalc.cpp:918-965 reads the
+//     cell's own value and two neighbours'), and the art has already been chosen
+//     for the mirrored shape, so it must stay with the art it produced.  Reflecting
+//     it here would make the stored value disagree with the tiles.
+//   * levelAndPassability_ / movementZones_ - read only by
+//     RecalculateCellAttributes and GetMoveError, both of which have already run,
+//     and Cleanup() frees them immediately after this pass.
+// ===========================================================================
+bool RandomMapGenerator::MirrorMap(mg::MapSymmetry kind)
+{
+    // -----------------------------------------------------------------------
+    // [移植侧] 已测并否决：纹理级"整半场镜像"（把 1x1 单格瓦片从权威半场镜像过来）。
+    //
+    // 动机仍然是那个差距：官方手绘对称图（画面竖中线为轴，左半 vs 右半翻转）12.1 / >20 19.3%
+    // / 暗像素 0.09%，我们当前 20.3 / 40.4% / 0.05%，差在 20~60 那段纹理。
+    //
+    // 结果：纹理确实镜像上了（>20 从 40.4% 降到 28.8%，接近官方），**但暗像素 0.05% -> 2.09%**，
+    // 又是黑缝。连同这一版共试了四种变体，全都这样：
+    //   ① 只搬 瓦片+子帧+坡面号；② 跳过岸族；③ 整格结构拷贝（保留自身坐标）；
+    //   ④ 只搬 1x1、多格族全跳过（本版）。
+    // 结论：**事后重写镜像半场的瓦片层，这个引擎就会撕出黑缝**；瓦片必须由生成器自己的 pass
+    // 写（这也与更早那次"只抄 1x1 岸/水瓦片 -> 3.97%"一致）。
+    //
+    // 所以纹理那一半差距只能从**源头**补：让各个生成 pass 自己的随机决策也镜像共享
+    // （岸片已经这样做了，效果最大：镜像海岸对中位 24.6 -> 12.9），而不是事后搬瓦片。
+    // -----------------------------------------------------------------------
+
+    // -----------------------------------------------------------------------
+    // [移植侧] 已测并否决：把权威半场的**逐格瓦片数据整份镜像**到对面（整半场镜像）。
+    //
+    // 动机：官方手绘对称图在同一把尺子（以画面竖中线为轴，左半 vs 右半翻转）上是
+    // 平均差 12.1、差异>20 占 19.3%、暗像素 0.09%；我们当前是 20.3 / 40.4% / 0.05%。
+    // 差的正是 20~60 那一段纹理（>60 的大差异两边都是 3%，说明几何本来就对）。
+    //
+    // 结果：纹理确实镜像上了 —— 差异>20 从 40.4% 降到 28.9%/31.5%（接近官方 19.3%）——
+    // **但冒出黑缝：暗像素 0.05% -> 2.13%**。试过三种变体都一样：
+    //   ① 只搬 瓦片+子帧+坡面号；② 跳过岸族；③ 整格结构拷贝（保留自身坐标）。
+    // 说明还有某个参与渲染、又不在 MapCell 里的层没有跟着镜像（还没定位到）。
+    // 按"渲染为准"，黑缝不可接受，故撤销，行为保持当前已推送的版本。
+    // -----------------------------------------------------------------------
+
+    // -----------------------------------------------------------------------
+    // [移植侧] 海岸的镜像化到这里为止（本 pass 不再动岸片）。三层都量过：
+    //
+    // 1) 选片层：两半的岸片是同一张片（数据层 (片号,片内偏移) 完全一致）——也就是"海岸只做
+    //    一次决定"，任何缺陷都不会只出现在一侧。这是 SelectShoreTile 的 roll 镜像共享做到的。
+    // 2) 偏移层：试过在最后一道 pass 把镜像半场的片内偏移按镜像转置（早段做过一次，被随后的
+    //    岸片盖章按片内格号重算回去，诊断打印：写 3、落盘前又变回 1；放到 MirrorMap 里之后
+    //    确认落盘生效，134 格改变）。但渲染变差：镜像海岸对 平均 13.1 -> 18.1、中位 12.9 ->
+    //    18.8、最差 21.0 -> 27.0。所以"平移"比"强制镜像"好，撤销。
+    // 3) 美术层：这套瓦片集里不存在互为镜像的两片 —— 同一片与它自己的水平翻转的基线差就有
+    //    22，而现在的"平移"摆法已经做到 12.9，比那个基线还低。
+    //
+    // 结论：两半河岸做不到逐像素镜像；当前摆法（同一张片 + 生成器自己的镜像感知选择）是实测
+    // 最优。残余差异来自美术本身，不是铺错了。
+    // -----------------------------------------------------------------------
+
+
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorMap: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && !mg::IsRotation180(kind)
+        && kind != mg::MapSymmetry::AxialTopBottom)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorMap: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+
+    // ---- the elevation of land types 3/4 is NOT re-copied here ---------------
+    //
+    // Tried, measured, rejected.  The carving-time copy fixes the half, but the stages
+    // after it write Level per cell from a running RNG (CreateHills above all), and the
+    // result is visible: on a size-2 Inland map 8830 of 13992 mirrored pairs disagreed
+    // on the elevation, and the mirrored water body rendered with a stepped edge on one
+    // side because its cells sat at different heights.  Copying the half once more right
+    // here - after every writer of Level - does close that (0 of 13992), but it breaks
+    // the RENDER: dark pixels went 0.39% -> 3.31% on Inland and 0.12% -> 2.59% on a snow
+    // Mountainous map, because each copied cell brings art that was chosen for the
+    // height it had on the other side.  The same lesson as on the continent types:
+    // elevation and art are one thing and cannot be moved separately.
+    //
+    // Closing the interior therefore needs the generator's own RNG-driven stages to
+    // choose mirror-consistently - a change inside them (one draw per mirrored pair,
+    // applied to both cells), not a pass over their output.
+
+    // That is what the three source-side fixes now do (FinalizeElevationSlopes and
+    // MergeSlopeBlocks decide per pair, MakeRegions evens the elevation out again after
+    // FixCliffLevels).  What is left is a handful of pairs the cliff placement chose
+    // differently before any of those ran; those are copied whole, and only those.
+    // See MirrorDivergedCells for why this narrow version works where the half-wide
+    // one did not.
+    if (!MirrorDivergedCells(kind))
+        return false;
+
+    // ---- the overlay layer and the building flag ---------------------------
+    if (!MirrorOverlays(kind))
+        return false;
+
+    // ---- the ledgers: keep the authoritative half, then add its mirror -----
+    //
+    // A symmetric map has an object in BOTH halves, not one object moved to the
+    // other half, so each ledger keeps the entries on the authoritative side and
+    // appends mirrored copies of exactly those.  What sits on the axis (a cell that
+    // is its own image) is kept as it is and never duplicated.
+    auto authoritative = [&](const CellStruct& c) {
+        int mx = 0, my = 0;
+        if (!mg::MirrorCell(W, H, kind, c.X, c.Y, &mx, &my))
+            return true;                        // off the diamond: leave it alone
+        return c.X < mx || (c.X == mx && c.Y < my);
+    };
+    auto mirrorOf = [&](const CellStruct& c, int* ox, int* oy) {
+        return mg::MirrorCell(W, H, kind, c.X, c.Y, ox, oy);
+    };
+
+    {
+        std::vector<MapTerrainObject> kept, mirrored;
+        for (const MapTerrainObject& t : terrainObjects_)
+        {
+            if (!authoritative(t.coords))
+                continue;
+            kept.push_back(t);
+            int mx = 0, my = 0;
+            if (mirrorOf(t.coords, &mx, &my))
+            {
+                MapTerrainObject m = t;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                mirrored.push_back(m);
+            }
+        }
+        terrainObjects_ = kept;
+        terrainObjects_.insert(terrainObjects_.end(), mirrored.begin(), mirrored.end());
+    }
+    {
+        std::vector<MapStructure> kept, mirrored;
+        for (const MapStructure& s : structures_)
+        {
+            if (!authoritative(s.coords))
+                continue;
+            kept.push_back(s);
+            int mx = 0, my = 0;
+            if (mirrorOf(s.coords, &mx, &my))
+            {
+                MapStructure m = s;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                m.facing = MirrorFacing(kind, s.facing);
+                mirrored.push_back(m);
+            }
+        }
+        structures_ = kept;
+        structures_.insert(structures_.end(), mirrored.begin(), mirrored.end());
+    }
+
+    // Start points: the same rule, but a map whose starts all landed on one side
+    // would end up with none, so the other side becomes the source in that case.
+    // The count is preserved - a 2-player map stays a 2-player map.
+    {
+        std::vector<StartingPointRecord> kept, mirrored;
+        for (const StartingPointRecord& sp : startingPoints_)
+        {
+            if (!authoritative(sp.coords))
+                continue;
+            kept.push_back(sp);
+            int mx = 0, my = 0;
+            if (mirrorOf(sp.coords, &mx, &my))
+            {
+                StartingPointRecord m = sp;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                mirrored.push_back(m);
+            }
+        }
+        if (kept.empty())
+        {
+            for (const StartingPointRecord& sp : startingPoints_)
+            {
+                int mx = 0, my = 0;
+                if (!mirrorOf(sp.coords, &mx, &my))
+                    continue;
+                StartingPointRecord m = sp;
+                m.coords.X = mx;
+                m.coords.Y = my;
+                kept.push_back(m);
+                mirrored.push_back(sp);
+            }
+        }
+        // The mirrored copies need a FREE index.  The writer emits [Waypoints] keyed
+        // by each record's index, so a copy that reuses its source's index collides
+        // with it and the map ends up with fewer start points than players
+        // (measured: 2 -> 1).  Kept entries keep their own indices and stay first,
+        // because the writer derives HomeCell from startingPoints_[0].index.
+        {
+            std::vector<bool> used(256, false);
+            for (const StartingPointRecord& sp : kept)
+                if (sp.index >= 0 && sp.index < 256)
+                    used[static_cast<size_t>(sp.index)] = true;
+            int next = 0;
+            for (StartingPointRecord& m : mirrored)
+            {
+                while (next < 256 && used[static_cast<size_t>(next)])
+                    ++next;
+                if (next < 256)
+                {
+                    m.index = next;
+                    used[static_cast<size_t>(next)] = true;
+                }
+            }
+        }
+        startingPoints_ = kept;
+        startingPoints_.insert(startingPoints_.end(), mirrored.begin(), mirrored.end());
+    }
+
+    // waypoints_ is left alone on purpose: the writer derives [Header] Waypoint1..8
+    // from startingPoints_, so this table is not what gets written, and it is a
+    // per-cell one whose symmetry follows the shape the early pass already made
+    // symmetric.
+
+    // ---- the corridor overlays, which are NOT mirrored -------------------
+    //
+    // LinkSameLevelRegions draws its strip with orientation-specific overlays:
+    // 94 / 92 / 74 + (x % 4) with OverlayData = the distance from the near edge
+    // for a horizontal corridor, and 96 / 98 / 83 + (y % 4) for a vertical one
+    // (MapGenMakingSub.cpp, the comment above LinkSameLevelRegions).  A mirror
+    // turns one into the other, so those cells would need their family swapped -
+    // not merely their cell moved - and that transform is NOT implemented.
+    //
+    // It is not implemented because it cannot be tested: measured over 180
+    // generated maps (sizes 0/1/2/3/3.6 x players 2/4/8 x land 0/2/3/4 x three
+    // seeds), 162202 overlaid cells, 34 distinct overlay indices spanning 27..177
+    // - NONE fell in [74,98].  The function IS reachable (it is called from
+    // MapGenMakingSub.cpp:1305), so this is "not observed", not "dead", and writing
+    // an untestable transform is what this project forbids.  Making the assumption
+    // detectable is the alternative: tools/verify_symmetry.py fails if a generated
+    // map ever carries one.
+    // ---- [移植侧] 非左右对称：水面统一成同一张 1x1 水片（子帧 0） ----------------
+    // 用户的观察：非左右对称时"水块没铺对称"。查下来确实如此 —— 水族里 314..321 是 2x2 片
+    // （四块纹理不同、相位在 180/上下这类映射下必翻面），而复制路径是**逐格照抄**，于是镜像
+    // 水格上的"片+子帧"只有 29.3% 与权威侧相同（左右对称是 64%、仅片同 97%）。
+    // 把每一格水都设成同一张 1x1 片 + 子帧 0 之后：镜像水格对 **174/174 = 100% 相同**（实测）。
+    // 必须在 DecorateWaterTiles **之后**做（那一趟只处理"片号==基础水片"的格，会重铺）。
+    // 不影响左右对称（它那半边不进来）。
+    if (kind != mg::MapSymmetry::AxialLeftRight && waterTileIndex_ >= 0)
+    {
+        long long unified = 0;
+        for (int y = 0; y < slotRows_; ++y)
+        {
+            for (int x = 0; x < 512; ++x)
+            {
+                MapCell* c = cellSlots_[512 * y + x];
+                if (c == nullptr)
+                    continue;
+                const int t2 = c->IsoTileTypeIndex;
+                if (t2 >= waterTileIndex_ && t2 < waterTileIndex_ + 14)
+                {
+                    c->IsoTileTypeIndex = waterTileIndex_ + 8;   // 1x1，只覆盖自己这一格
+                    c->Height = 0;
+                    ++unified;
+                }
+            }
+        }
+        std::fprintf(stderr, "[symmetry] water-uniform: %s, %lld water cells set to one "
+                     "1x1 piece\n", mg::MapSymmetryName(kind), unified);
+    }
+
+    // ---- [诊断·只读] 最后一站的族统计：两半各有多少格、多少格映不出对应件 -------
+    if (kind != mg::MapSymmetry::AxialLeftRight)
+    {
+        const int W = size_.mapWidth, H = size_.mapHeight;
+        struct Fam { const char* name; int base; int count; };
+        Fam fams[] = {
+            {"CliffSet", shoreTileIndex_, 40},
+            {"CliffWater", waterCliffsIndex_, 28},
+            {"DestroyableCliff", destroyableCliffsIndex_, 2},
+            {"Ramps", cliffRampsIndex_, -1},
+            {"Caves", waterCavesIndex_, -1},
+            {"Waterfall", waterFamily4Base_[0], 4},
+        };
+        for (Fam& f : fams)
+        {
+            if (f.base < 0)
+                continue;
+            long long total = 0, can = 0, img = 0, canNoPartner = 0;
+            for (int y = 0; y < slotRows_; ++y)
+            {
+                for (int x = 0; x < 512; ++x)
+                {
+                    MapCell* c = cellSlots_[512 * y + x];
+                    if (c == nullptr)
+                        continue;
+                    const int t2 = c->IsoTileTypeIndex;
+                    bool in = false;
+                    if (f.count > 0)
+                        in = (t2 >= f.base && t2 < f.base + f.count);
+                    else if (std::strcmp(f.name, "Ramps") == 0)
+                        in = (t2 >= f.base && t2 < f.base + 49);
+                    else
+                        in = (t2 >= f.base && t2 < f.base + 6);
+                    if (!in)
+                        continue;
+                    ++total;
+                    int mx = 0, my = 0;
+                    if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                        continue;
+                    const bool canonical = mg::AuthoritativeXY(kind, x, y, mx, my);
+                    if (canonical)
+                    {
+                        ++can;
+                        int h2 = 0; bool approx = false;
+                        if (MirrorTile(t2, kind, &h2, &approx) < 0)
+                            ++canNoPartner;
+                    }
+                    else
+                        ++img;
+                }
+            }
+            std::fprintf(stderr, "[diag] family %-18s base %4d  total %5lld  canonical %5lld "
+                         "(no partner %lld)  image %5lld\n", f.name, f.base, total, can,
+                         canNoPartner, img);
+        }
+    }
+
+    // ---- [移植侧] 补完"盖章中途中断"的岸片 -----------------------------------------
+    // 实测：上下对称的镜像半场上有 14 处"一件没放完" —— 该件只写下了自己那几格，同一足印里
+    // 剩下的格留在占位，渲染成 Clear01。权威半场 0 处、无对称 0 处、左右对称 3 处。
+    // 成因：PlaceIsoTile 按行序往足印格写，撞上已被别人占的格就在循环中途 return false，
+    // 已写的格不回滚、没写到的格保持占位。
+    // 修法：给每件**自己**剩下的、仍是占位的足印格补上（片号 + 正确的片内偏移 Height = col +
+    // row*w）。只写占位格，绝不覆盖任何已有美术。
+    // 放在最后这道 pass：早于 InitRegions/CreateHills/CreateLATs 的占位格状态是那些阶段的输入，
+    // 在早处补会改掉它们的输入（实测 13005 格里 9487 格被改，布局全变）。
+    if (shorePieces_ >= 0 && cellSlots_ != nullptr)
+    {
+        std::vector<std::pair<int, int> > shoreCells;
+        for (int y = 0; y < slotRows_; ++y)
+        {
+            for (int x = 0; x < 512; ++x)
+            {
+                MapCell* c = cellSlots_[512 * y + x];
+                if (c == nullptr)
+                    continue;
+                const int t = c->IsoTileTypeIndex;
+                if (t >= shorePieces_ && t < shorePieces_ + 42)
+                    shoreCells.push_back(std::make_pair(x, y));
+            }
+        }
+        long long completed = 0;
+        int piecesDone = 0;
+        for (size_t k = 0; k < shoreCells.size(); ++k)
+        {
+            const int x = shoreCells[k].first, y = shoreCells[k].second;
+            const MapCell* c = cellSlots_[512 * y + x];
+            const int t = c->IsoTileTypeIndex;
+            int cols = 0, rows = 0;
+            if (!TileFootprint(t, &cols, &rows) || cols * rows <= 1)
+                continue;
+            const int sub = c->Height;
+            if (sub < 0 || sub >= cols * rows)
+                continue;
+            const int ax = x - (sub % cols);
+            const int ay = y - (sub / cols);
+            int cellsOff[64][2];
+            const int nOff = TileFootprintCells(t, cellsOff, 64);
+            long long filledHere = 0;
+            for (int i = 0; i < nOff; ++i)
+            {
+                const int sx = ax + cellsOff[i][0];
+                const int sy = ay + cellsOff[i][1];
+                if (sx < 0 || sy < 0 || sx >= 512 || sy >= slotRows_)
+                    continue;
+                if (!CellExists(sx, sy))
+                    continue;
+                MapCell* d = cellSlots_[512 * sy + sx];
+                if (d == nullptr || d->IsoTileTypeIndex == t)
+                    continue;
+                if (!IsPlaceholderTile(d))
+                    continue;                        // 别人的美术：不动
+                d->IsoTileTypeIndex = t;
+                d->Height = static_cast<uint8_t>(cellsOff[i][1] * cols + cellsOff[i][0]);
+                ++filledHere;
+            }
+            if (filledHere != 0)
+            {
+                completed += filledHere;
+                ++piecesDone;
+            }
+        }
+        if (completed != 0)
+            std::fprintf(stderr, "[symmetry] shore-complete: %s, completed %lld cells across "
+                         "%d partially stamped shore pieces\n",
+                         mg::MapSymmetryName(kind), completed, piecesDone);
+    }
+
+    std::fprintf(stderr,
+                 "[symmetry] placed: %s, %zu start points, %zu waypoints, %zu terrain "
+                 "objects, %zu structures (the overlay layer is reported by "
+                 "MirrorOverlays above)\n",
+                 mg::MapSymmetryName(kind), startingPoints_.size(),
+                 waypoints_.size(), terrainObjects_.size(), structures_.size());
+    return true;
+}
+
+// ===========================================================================
+// MirrorSpecialTerrain - Inland / Mountainous (LandType 3/4).
+//
+// These two land types never run GenerateTerrain: the base is land already (nothing
+// floods the map with water) and the terrain comes from GenerateSpecialTerrain, which
+// carves a river and then lakes into it.  Measured on the finished map before this
+// existed: the pass' shape mirror never ran at all (it lives inside GenerateTerrain) and
+// the outline scored 0.961 - which is the chance level for a map that is almost all
+// land, and identical to the same map generated with symmetry off.
+//
+// Two differences from the Continent path decide what has to happen here:
+//   * the carving stamps its ART as it goes (river shores, the cliff banks along them)
+//     instead of leaving it to a later stage, so mirroring only the shape would leave
+//     the water in mirrored places and its banks where they were carved;
+//   * it cannot run before the carving: GenerateSpecialTerrain starts from whatever the
+//     cells already hold, so there is no "shape is complete, art has not started" moment
+//     to hook into.
+// So the cells are copied whole - payload AND art - with the multi-cell pieces turned
+// into their mirrored pieces (MirrorTile) and SlopeIndex reflected, and then
+// RecalculateCellAttributes() re-derives the neighbour-dependent art (LAT masks, ramp
+// smoothing) from the now-symmetric cells.  On this land type the ground is a uniform
+// fill, which is the condition under which copying finished art is safe: on Continent
+// the same copy was measured at 1.38% dark pixels because the ground art varies per
+// cell, and here the per-stage check on the rendered image is what decides.
+//
+// The driver calls this after GenerateSpecialTerrain returns (that function has an early
+// return on a successful lake, so it cannot host the call itself).
+// ===========================================================================
+bool RandomMapGenerator::MirrorSpecialTerrain(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+
+    // [移植侧/诊断] MG_DUMP_MIRROR=1 时，一次性把崖族 40 片在**当前对称下**的
+    // MirrorTile 结果打出来。用途：目标②要知道"引擎现在给每一片配的是谁"，而"两半里
+    // 碰巧都是崖族格的片号相关"**不是**这个答案（权威半场的崖件是崖算法独立选的，
+    // 不是镜像复制的）—— 实测就因此得出过"29 片要改"的错误口径。
+    // 只在环境变量打开时执行，不改产品行为。
+    if (const char* dump = std::getenv("MG_DUMP_MIRROR"); dump != nullptr && dump[0] == '1')
+    {
+        std::fprintf(stderr, "[dump-mirror] kind=%d shoreTileIndex_=%d\n",
+                     static_cast<int>(kind), shoreTileIndex_);
+        for (int p = 0; p < 40; ++p)
+        {
+            int h = 0;
+            bool approx = false;
+            const int q = MirrorTile(shoreTileIndex_ + p, kind, &h, &approx);
+            std::fprintf(stderr, "[dump-mirror] kind=%d p=%2d -> q=%3d (height=%d approx=%d)\n",
+                         static_cast<int>(kind), p, q, h, approx ? 1 : 0);
+        }
+    }
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorSpecialTerrain: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && !mg::IsRotation180(kind)
+        && kind != mg::MapSymmetry::AxialTopBottom)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorSpecialTerrain: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+
+    long long cells = 0, turned = 0, approximated = 0, shoreKept = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;
+            if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                continue;                           // `a` is the authoritative side
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                std::fprintf(stderr, "[symmetry] MirrorSpecialTerrain: mirrored pair "
+                             "(%d,%d) has no cell on the other side\n", x, y);
+                return false;
+            }
+            int tile = a->IsoTileTypeIndex;
+            int height = a->Height;
+            bool approx = false;
+            // [移植侧] 岸族交还给生成器自己的镜像感知选择：SelectShoreTile 已让镜像半场用
+            // 镜像伙伴那一格的 roll 走同一棵官方决策树，选出来的片就是"同一随机输入下的对应
+            // 输出"（形状与变体都对应）。这里若再按"形状转置"覆盖一次，反而打散那份对应关系
+            // —— 实测两者同时开着时，roll 共享对最终图完全没有影响。
+            // （先前那次 A/B 结论是"交还更差"，但那时 roll 没有共享，镜像侧是另一次独立抽签。）
+            // [移植侧] 对称：只搬形状，不搬"为另一个形状选的海岸美术"。
+            // 水格 -> 基础水片；岸件（shorePieces_ 族）-> 占位格。两半随后一起由官方那套
+            // SmoothWaterBody 重新上妆（见本函数末尾），于是每一格的岸片都是照着**现在这个
+            // 对称形状**选的。--symmetry 0 不经过这里。
+            // [移植侧] 对称：只搬形状，不搬"为另一个形状选的海岸美术"（仅左右对称）。
+            // 水格 -> 基础水片（水沿细节交给 DecorateWaterTiles）、岸件 -> 占位格；两半随后一起
+            // 由官方那两趟选片 pass 成对重上妆（见本函数末尾）。180 保持原样：它的镜像关系是
+            // 绕中心的 180° 旋转，"照着自己形状选片"这条路线在它上面不成立（实测成对盖章 139 次
+            // 失败，markerBad 0 -> 45、最终 1158；水细节片偏移旋转虽让水层中位 15.19 -> 9.31，
+            // 但最终 markerBad 585 -> 1014、crossFam 1072 -> 1412，一并回退）。
+            const bool srcIsWater = IsWaterTile(a);
+            const bool srcIsShore = !srcIsWater && shorePieces_ >= 0
+                && tile >= shorePieces_ && tile < shorePieces_ + 42;
+            if (kind == mg::MapSymmetry::AxialLeftRight && srcIsWater)
+            {
+                b->IsoTileTypeIndex = waterTileIndex_;
+                b->Height = height;
+            }
+            else if (kind == mg::MapSymmetry::AxialLeftRight && srcIsShore)
+            {
+                b->IsoTileTypeIndex = 0;
+                b->Height = 0;
+                ++shoreKept;
+            }
+            else if (srcIsShore)
+            {
+                // [移植侧] 180 的岸片交给 MirrorTile 选对应件 —— 它现在按 **180 的剖面置换**
+                // 挑（MapGenRiver.cpp 的 Rot180WaterProfile）。数据层核对：42 片里 38 片存在
+                // "足印+剖面都对"的 180 对应件（缺 3、19 与 40/41）。原样复制只会把"为另一个
+                // 形状选的朝向"搬过去，镜像半场因此走样。
+                int t2 = tile;
+                int h2 = height;
+                const int partner = MirrorTile(tile, kind, &h2, &approx);
+                if (partner >= 0)
+                {
+                    t2 = partner;
+                    ++turned;
+                    if (approx)
+                        ++approximated;
+                }
+                b->IsoTileTypeIndex = t2;
+                b->Height = h2;
+                ++shoreKept;
+            }
+            else if (srcIsWater)
+            {
+                // 180：水片原样（基线）。试过在这里也退回基础水片、让 DecorateWaterTiles
+                // 按镜像后的邻居重选 —— 实测**地图逐字节不变**：那一趟本来就会重铺所有
+                // 基础水格的格，复制路径没有改变它的输入。所以 180 的水沿片不是这里的账。
+                b->IsoTileTypeIndex = tile;
+                b->Height = height;
+            }
+            else
+            {
+                // 其它族（崖、水崖、瀑布…）走 MirrorTile 的足印+偏移镜像（与基线一致）
+                int t2 = tile;
+                int h2 = height;
+                const int partner = MirrorTile(tile, kind, &h2, &approx);
+                if (partner >= 0)
+                {
+                    t2 = partner;
+                    ++turned;
+                    if (approx)
+                        ++approximated;
+                }
+                b->IsoTileTypeIndex = t2;
+                b->Height = h2;
+            }
+            b->Level = a->Level;
+            b->SlopeIndex = mg::ReflectSlope(kind, a->SlopeIndex);
+            b->LandType = a->LandType;
+            b->Passability = a->Passability;
+            b->TubeIndex = a->TubeIndex;
+            b->ZAdjust = a->ZAdjust;
+            b->CellFlags = a->CellFlags;
+            ++cells;
+        }
+    }
+
+    // The neighbour-dependent art (LAT masks, ramp smoothing) is deliberately NOT
+    // re-derived here.  It was, and measurement said not to: the copy above is exact
+    // (0 mirrored pairs disagree on the land/water marker), while calling
+    // RecalculateCellAttributes() inside this pass left 492 of 6952 pairs differing in
+    // their tiles and 394 with a different Height, against 394 / 197 without it.  That
+    // function is deterministic (MapGenRecalc.cpp draws no RNG) but NOT mirror-
+    // equivariant: it walks the cells once and later cells read neighbours it has
+    // already rewritten.  The pipeline calls it four more times further on anyway, so
+    // dropping it here loses nothing and keeps the state as close to symmetric as
+    // possible.
+
+    // ---- 海岸重新上妆：卸掉两半的挖地形岸件，按镜像格成对重选 --------------
+    // 只跑官方那两趟选片（mode 1 + mode 2），**不**跑 FloodFill/CleanupTile ——
+    // 那两趟是形状修补，会把刚腾出来的占位格再清掉（实测 size2 配置下岸件归零）。
+    // 访问顺序按"权威格与它的镜像格紧挨着"成对走：官方盖章是有顺序依赖的（一片盖住
+    // 的格子会影响后面的判定），成对访问让两半的盖章序列互为镜像，抽签共享也因此
+    // 天然对齐（权威格先记、镜像格随后取）。
+    // 只做左右对称。180 的镜像格彼此远、盖章序列无法成对（实测 139 次失败），而且它本来
+    // 就没有"同一张片平移"的岸片对（340/340 已是足印镜像件）——重妆只会把它弄差：
+    // 岸带镜像差 25.06 -> 32.61（size2/4p、同参数），所以 180 保持复制路径。
+    // 铺不上的格子要还原：卸妆之前先把每个岸格的 (片号, 片内偏移) 存一份，两趟跑完后仍是
+    // 占位格的格子说明官方 pass 在这个位置铺不下（180 实测 45 格，左右对称 0 格），把原来的
+    // 美术还回去 —— 否则那半场会留下"一边有美术、一边是空地"的镜像对，形状都不对称了。
+    // 只做左右对称与上下对称：180 的镜像格彼此远、成对盖章有 139 次失败，实测把它弄差（本函数
+    // 末尾那段的注释有数）；180 的水沿片改由上面的"退回基础水片 + DecorateWaterTiles 重选"处理。
+    //
+    // [移植侧/修 TB] 上下对称原来**不**走这里，而是走下面那段"岛屿做法"（把 712 格岸件全换成
+    // 普通地面）。那样做的理由是当时认定"岸族的美术在反对角翻转下不闭合"；实测重新量过：
+    //   1. 岸族的**足印**闭合度和左右对称完全一样（都是 40/42，缺的同样是 slot 41/42）；引擎
+    //      自己的 MirrorTile 在这张图上把 360 片全部配到了精确对应件（0 片走"最近件"回退）；
+    //   2. 抹掉的代价是整张图**没有海岸**：湖岸只剩"水对沙"的硬锯齿，肉眼一眼能看出（用户看到
+    //      的就是这个）；
+    //   3. 不抹（只留着复制过来的岸件）更差：镜像半场一片黑阶梯（黑 55304 -> 64611、族别 274 ->
+    //      423），因为复制件的朝向是为**权威半场**的形状选的；
+    //   4. 走和左右对称同一条"卸妆 -> 成对重选"才两边都对：黑 62245、族别 226、未覆盖落差 0/2636。
+    // 所以 TB 改成走这一条。左右对称的行为一个字节都不变（下面那段本来就是它的路径）。
+    if (kind == mg::MapSymmetry::AxialLeftRight
+        || kind == mg::MapSymmetry::AxialTopBottom)
+    {
+        const int side = size_.workSide;
+        long long undressed = 0, visited = 0, failed = 0, restored = 0;
+        std::vector<std::pair<int, std::pair<int, int> > > shoreBackup;
+        for (int y = 0; y < slotRows_; ++y)
+        {
+            for (int x = 0; x < 512; ++x)
+            {
+                MapCell* c = cellSlots_[512 * y + x];
+                if (c == nullptr)
+                    continue;
+                const int t = c->IsoTileTypeIndex;
+                if (shorePieces_ >= 0 && t >= shorePieces_ && t < shorePieces_ + 42)
+                {
+                    shoreBackup.push_back(std::make_pair(
+                        c->MapCoords, std::make_pair(t, c->Height)));
+                    c->IsoTileTypeIndex = 0;
+                    c->Height = 0;
+                    ++undressed;
+                }
+                else if (IsWaterTile(c) && kind == mg::MapSymmetry::AxialLeftRight)
+                {
+                    c->IsoTileTypeIndex = waterTileIndex_;
+                }
+                workCells_[x + side * y].data[16] = -1;      // 掩码按本侧瓦片重算
+            }
+        }
+        for (int mode = 1; mode <= 2; ++mode)
+        {
+            for (int y = 0; y < slotRows_; ++y)
+            {
+                for (int x = 0; x < 512; ++x)
+                {
+                    MapCell* a = cellSlots_[512 * y + x];
+                    if (a == nullptr)
+                        continue;
+                    int mx = 0, my = 0;
+                    if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                        continue;
+                    if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                        continue;                           // 每对只从权威格发起
+                    MapCell* b = cellSlots_[512 * my + mx];
+                    ++visited;
+                    if (!SelectShoreTile(a, mode, genCode_, 0))
+                        ++failed;
+                    if (b != nullptr && b != a
+                        && !SelectShoreTile(b, mode, genCode_, 0))
+                        ++failed;
+                }
+            }
+        }
+        for (size_t i = 0; i < shoreBackup.size(); ++i)
+        {
+            const int packed = shoreBackup[i].first;
+            MapCell* c = CellAt(static_cast<int16_t>(packed & 0xFFFF),
+                                static_cast<int16_t>(static_cast<uint32_t>(packed) >> 16));
+            if (c != nullptr && c->IsoTileTypeIndex == 0)
+            {
+                c->IsoTileTypeIndex = shoreBackup[i].second.first;
+                c->Height = shoreBackup[i].second.second;
+                ++restored;
+            }
+        }
+        std::fprintf(stderr, "[symmetry] coast: %s, undressed %lld shore cells, re-selected "
+                     "in mirrored pairs over the whole map (%lld pair visits, %lld reported "
+                     "failure), restored %lld that the pass could not dress\n",
+                     mg::MapSymmetryName(kind), undressed, visited, failed, restored);
+    }
+
+    // ---- [移植侧/修 TB] 已删除：上下对称的"岛屿做法"（岸片 -> 普通地面） ------------
+    // 它原来把整张图的 712 格岸件换成普通地面，理由是"这套 tileset 没有按反对角翻转画的岸片
+    // 美术"。重新实测后作废，理由见上面那段（足印闭合度与左右对称一致、引擎能配到精确对应件、
+    // 抹掉的代价是整张图没有海岸）。上下对称现在和左右对称走同一条成对重选。
+    // 保留这条注释是为了说明"为什么这里空着"：不要再把它加回来。
+
+    // Report, and check the result against itself - the rendered map cannot tell
+    // whether a shape mirror worked (an unmirrored map scores 0.961 here by itself).
+    long long pairs = 0, disagree = 0, water = 0, land = 0, other = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            const bool aw = IsWaterTile(a);
+            if (aw) ++water;
+            else if (a->IsoTileTypeIndex == 0) ++land;
+            else ++other;
+
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;
+            if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                continue;
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+                continue;
+            ++pairs;
+            if (aw != IsWaterTile(b))
+                ++disagree;
+        }
+    }
+    std::fprintf(stderr,
+                 "[symmetry] special: %s, copied %lld cell pairs whole, %lld art pieces "
+                 "turned (%lld of them to a best-approximation piece - the tileset has no "
+                 "exact mirrored partner for those; %llu coast pieces chosen by the measured "
+                 "water-direction table, %llu of them by the style preference); %lld shore tiles left "
+                 "to the generator's own mirror-aware decision; self-check "
+                 "%lld pairs, %lld disagree "
+                 "about water (water=%lld land=%lld other=%lld)\n",
+                 mg::MapSymmetryName(kind), cells, turned, approximated,
+                 MgShoreProfilePicked(), MgShoreStyleFallback(), shoreKept, pairs, disagree,
+                 water, land, other);
+    return disagree == 0;
+}
+
+
+// ===========================================================================
+// MirrorLevels - the elevation field only, for the window inside MakeRegions
+// where the levels have been assigned but no art depends on them yet.
+//
+// RebuildRegionBodies and ReseedRegions assign the elevation, and they are driven by a
+// randomised region growth: the region's seed CELL is drawn at random, its heading is
+// drawn at random, the split target is drawn at random and (for large regions) the level
+// is picked from a candidate list at random.  The two halves therefore run two DIFFERENT
+// growths.  Measured: sharing the growth's priority draw per mirrored pair made it worse
+// (MakeRegions went from 1378 to 2159 disagreeing pairs), because pairing values across
+// two unrelated growths is meaningless - so this term cannot be fixed by sharing draws.
+//
+// What CAN be done is to even out the result, and the window matters: everything that
+// turns a level into art (FixCliffLevels, PlaceCliffs, CorrectCliffTiles, CreateHills,
+// CreateLATs, RecalculateCellAttributes) runs AFTER these two functions.  Copying the
+// level field here therefore gives those stages a symmetric input and lets them choose
+// symmetric art themselves.  Doing the same copy at the END of the pipeline is what was
+// tried and rejected before: by then the art is already chosen for the other half's
+// heights, and the render went from 0.39% to 3.31% dark pixels.
+//
+// With symmetry off this returns immediately, so the vanilla path does not change.
+// ===========================================================================
+bool RandomMapGenerator::MirrorLevels(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorLevels: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && !mg::IsRotation180(kind)
+        && kind != mg::MapSymmetry::AxialTopBottom)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorLevels: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    long long pairs = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(size_.mapWidth, size_.mapHeight, kind, x, y, &mx, &my))
+                continue;
+            if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                continue;                           // `a` is the authoritative side
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                std::fprintf(stderr, "[symmetry] MirrorLevels: mirrored pair (%d,%d) has "
+                             "no cell on the other side\n", x, y);
+                return false;
+            }
+            b->Level = a->Level;
+            ++pairs;
+        }
+    }
+    std::fprintf(stderr, "[symmetry] levels: %s, copied the elevation of %lld cell "
+                 "pairs before any art was chosen for it\n",
+                 mg::MapSymmetryName(kind), pairs);
+    return true;
+}
+
+// ===========================================================================
+// MirrorDivergedCells - the last few pairs that still disagree, copied whole.
+//
+// WHY A REPAIR AT THE END IS RIGHT HERE, when the same move was rejected before.
+// The rejected version copied the WHOLE half, or the whole 1x1 texture layer, and it
+// rendered 2.09-2.61% dark: by the end of the pipeline every cell carries art chosen
+// for the height it had, so moving half of them wholesale tears the walls open.  This
+// pass moves only the pairs that ALREADY disagree - measured on the gate's Inland map
+// after the level/sub-frame fixes above, 28 of 13005 - and for those the copy is not a
+// guess: the authoritative cell's configuration is one that already renders correctly
+// (its art covers its own drop), and the image cell is its mirror, so the mirrored
+// piece is the piece the geometry calls for.  The alternative - leaving them - is the
+// 930 px black zigzag in the middle of the map, which is what this closes.
+//
+// A pair counts as diverged when the elevation differs, when the multi-cell FAMILY
+// differs (a cliff against a ramp), or when one side is a placeholder (tile 0 / 0xFFFF)
+// and the other is not.  The tile INDEX differing is normal and not a divergence: a
+// symmetric map is supposed to put the mirrored piece on the image cell.
+//
+// Left-right only: the same pass on the 180 map would have to mirror 16% of the pairs,
+// and mirror.h records why that floor exists.  With symmetry off it returns immediately.
+// ===========================================================================
+bool RandomMapGenerator::MirrorDivergedCells(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    // [移植侧/实测否决] 试过对 180 也开放本函数（LR 一直靠它把斜坡族整格抄到镜像侧）。
+    // 结果**明确更差**：同一张内陆图上"自己配自己"的斜坡格 102 → 758，多伙伴源片仍是 22/22，
+    // 而**暗像素（黑缝）0.45% → 3.58%（8 倍）**。即 180 的格映射不是 8 邻域自同构（对角邻居
+    // 互换），整格拷贝会把为另一个对角形状选的艺术搬过去 → 撕缝。已撤回，180 保持不开放。
+    // 斜坡在 180 下的正确做法见 mirror.h 的记录：给斜坡族建**方向表**（20 片，方向可从
+    // 高程网格读出来——斜坡连接两层），按方向映射，而不是整格抄。
+    // [移植侧] 上下对称（反对角线）与左右对称同属**反射**，格映射保持邻域，所以这趟
+    // "整格抄家族不同的对"对它同样适用（180 是旋转，实测会撕黑缝，仍然排除）。加上它之后
+    // TB 的逐格随机美术（LAT/草地/沙地变体）才和 LR 一样被镜像过去。
+    if (kind != mg::MapSymmetry::AxialLeftRight)
+        return true;                                  // see the note above
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorDivergedCells: no cells allocated\n");
+        return false;
+    }
+
+    // The same five families MirrorTile resolves, so "different family" means the same
+    // thing in both places.
+    auto familyOf = [this](int tile) -> int
+    {
+        if (tile < 0)
+            return -1;
+        if (shorePieces_ >= 0 && tile >= shorePieces_ && tile < shorePieces_ + 42) return 0;
+        if (shoreTileIndex_ >= 0 && tile >= shoreTileIndex_ && tile < shoreTileIndex_ + 40) return 1;
+        if (waterCliffsIndex_ >= 0 && tile >= waterCliffsIndex_ && tile < waterCliffsIndex_ + 28) return 2;
+        if (destroyableCliffsIndex_ >= 0 && tile >= destroyableCliffsIndex_
+            && tile < destroyableCliffsIndex_ + 2) return 3;
+        for (int f = 0; f < 4; ++f)
+            if (waterFamily4Base_[f] >= 0 && tile >= waterFamily4Base_[f]
+                && tile < waterFamily4Base_[f] + 4) return 4 + f;
+        return -1;
+    };
+
+    long long pairs = 0, fixed = 0, keptPiece = 0, levelOnly = 0, familyOnly = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(size_.mapWidth, size_.mapHeight, kind, x, y, &mx, &my))
+                continue;
+            if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                continue;                           // `a` is the authoritative side
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+                continue;
+            ++pairs;
+
+            const bool lvlBad = a->Level != b->Level;
+            const bool famBad = familyOf(a->IsoTileTypeIndex) != familyOf(b->IsoTileTypeIndex)
+                || (IsPlaceholderTile(a) != IsPlaceholderTile(b));
+
+            // Every pair whose multi-cell piece is not the one the geometry calls for is
+            // REPAIRED, but only when the piece the image half already holds is a
+            // multi-cell piece too - see the note above MirrorDivergedCells.  Measured:
+            // forcing the MirrorTile answer onto every mismatched multi-cell pair (266-626
+            // pairs per seed) makes the render WORSE on every seed tested (e.g. the gate's
+            // Inland map 0.29% -> 0.44% with a 4502 px black block), because the copied
+            // piece's other footprint cells stay where the image half put them.  So the
+            // test stays at level / family / placeholder, which is the set that measured
+            // better on every seed.
+            if (!lvlBad && !famBad)
+                continue;
+
+            int height = a->Height;
+            bool approx = false;
+            const int partner = MirrorTile(a->IsoTileTypeIndex, kind, &height, &approx);
+            b->IsoTileTypeIndex = (partner >= 0) ? partner : a->IsoTileTypeIndex;
+            b->Height = (partner >= 0) ? height : a->Height;
+            b->Level = a->Level;
+            b->SlopeIndex = mg::ReflectSlope(kind, a->SlopeIndex);
+            b->LandType = a->LandType;
+            b->Passability = a->Passability;
+            b->TubeIndex = a->TubeIndex;
+            b->ZAdjust = a->ZAdjust;
+            b->CellFlags = a->CellFlags;
+            ++fixed;
+            if (partner < 0)
+                ++keptPiece;
+            if (lvlBad)
+                ++levelOnly;
+            else
+                ++familyOnly;
+        }
+    }
+    std::fprintf(stderr, "[symmetry] diverged: %s, %lld of %lld cell pairs still "
+                 "disagreed at the end; %lld copied whole from the authoritative side "
+                 "(%lld on the elevation, %lld on the art family, %lld had no mirrored "
+                 "piece and kept the source piece)\n",
+                 mg::MapSymmetryName(kind), fixed, pairs, fixed, levelOnly, familyOnly,
+                 keptPiece);
+    return true;
+}
+
+// ===========================================================================
+// MirrorOverlays - the overlay layer and the building flag, copied from the
+// authoritative half onto its image.  Called twice by design:
+//   * by the driver right after AddTiberium and BEFORE CreateHills.  Not cosmetic: the
+//     ore and the tech buildings are placed with RNG, so until they are evened out the
+//     two halves differ in exactly the fields CanHostSlope() reads
+//     (OverlayTypeIndex != -1 and AltFlags & ContainsBuilding), and CreateHills'
+//     FinalizeElevationSlopes skips its level update wherever that test fails - which is
+//     where its measured 1216 mirrored pairs with a different Level came from.
+//   * by MirrorMap at the end, so anything placed after that point is evened out too.
+// Ore overlays carry no orientation (a random 0..11 variant plus a growth counter), so
+// moving them verbatim is exact - unlike tiles, which is why tiles are not touched.
+// ===========================================================================
+bool RandomMapGenerator::MirrorOverlays(mg::MapSymmetry kind)
+{
+    if (kind == mg::MapSymmetry::None)
+        return true;
+    if (cellSlots_ == nullptr)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorOverlays: no cells allocated\n");
+        return false;
+    }
+    if (kind != mg::MapSymmetry::AxialLeftRight && !mg::IsRotation180(kind)
+        && kind != mg::MapSymmetry::AxialTopBottom)
+    {
+        std::fprintf(stderr, "[symmetry] MirrorOverlays: %s is not implemented\n",
+                     mg::MapSymmetryName(kind));
+        return false;
+    }
+
+    const int W = size_.mapWidth;
+    const int H = size_.mapHeight;
+    long long overlays = 0, unpaired = 0;
+    for (int y = 0; y < slotRows_; ++y)
+    {
+        for (int x = 0; x < 512; ++x)
+        {
+            MapCell* a = cellSlots_[512 * y + x];
+            if (a == nullptr)
+                continue;
+            int mx = 0, my = 0;
+            if (!mg::MirrorCell(W, H, kind, x, y, &mx, &my))
+                continue;
+            if (!mg::AuthoritativeXY(kind, x, y, mx, my))
+                continue;                           // `a` is the authoritative side
+            MapCell* b = cellSlots_[512 * my + mx];
+            if (b == nullptr)
+            {
+                ++unpaired;
+                continue;
+            }
+            b->OverlayTypeIndex = a->OverlayTypeIndex;
+            b->OverlayData = a->OverlayData;
+            b->AltFlags = a->AltFlags;
+            if (a->OverlayTypeIndex >= 0)
+                ++overlays;
+        }
+    }
+    if (unpaired > 0)
+    {
+        std::fprintf(stderr, "[symmetry] WARNING: MirrorOverlays found %lld mirrored "
+                     "pairs with no slot on one side\n", unpaired);
+        return false;
+    }
+    std::fprintf(stderr, "[symmetry] overlays: %s, %lld overlay pairs and their building "
+                 "flags evened out\n", mg::MapSymmetryName(kind), overlays);
+    return true;
+}
+
+// The stamp guard below drops the cells that cannot be mirrored (see
+// StampMirroredBlob); the counts are reported by the callers so a silent loss of
+// mirroring - and of terrain detail - is visible.
+static unsigned long long g_mirrorStampDroppedBlobs = 0;
+static unsigned long long g_mirrorStampDroppedCells = 0;
+unsigned long long MgMirrorStampDroppedBlobs() { return g_mirrorStampDroppedBlobs; }
+unsigned long long MgMirrorStampDroppedCells() { return g_mirrorStampDroppedCells; }
+
+// ---------------------------------------------------------------------------
+// StampMirroredBlob - the mirrored copy of a blob that has just been placed.
+//
+// The blob scatter (ScatterLATBlobs / ScatterRocks) grows a patch with PlaceBlob,
+// which stamps ONE tile index on every accepted cell.  That tile is a 1x1 piece
+// with no orientation, so the mirrored patch is simply the mirror image of the
+// accepted cell set - there is nothing to re-decide.
+//
+// The first version of this instead called PlaceBlob a second time at the mirror
+// centre and trusted the two growths to come out mirrored: both draw the same
+// jitter (MirrorSharedValue keys it by cell) and both measure the same distances.
+// Measured, that is not enough.  The growth is a best-first heap: equal
+// priorities are broken by heap order, and the neighbour scan runs N, NE, E, SE,
+// S, SW, W, NW, whose mirror image is the reverse order.  Probed directly (a
+// trace of the stamped cells per pair): pair 1 stamped 27/27 cells and pair 2
+// 9/9 with the two sets exactly mirrored, but pair 3 stamped 31 cells with only
+// 27 in common - four cells of the patch landed on one side only.  Those four
+// spread, because every stamped cell changes what the LAT pass sees: after
+// ScatterLATBlobs the map had 455 mirrored pairs with a tile on one side and a
+// bare cell on the other.
+//
+// Mirroring the achieved set removes the question: the two halves get the same
+// patch by construction, while the patch itself is still the one the generator's
+// own algorithm chose.  Not a tile is moved from one half to the other - the
+// algorithm runs in the half it ran in, and its result is imaged.
+// ---------------------------------------------------------------------------
+int RandomMapGenerator::StampMirroredBlob(const std::vector<BlobStamp>& stamped,
+                                          int tileIndex)
+{
+    if (config_.symmetry == mg::MapSymmetry::None || stamped.empty())
+        return 0;
+
+    // Which cells of the patch can be mirrored?  A cell can, when its image is a
+    // placeholder - PlaceBlob grew the canonical patch by accepting placeholders and
+    // nothing else, so an image cell that is NOT one carries something the generator
+    // picked for a REASON.  Under left-right the two halves are neighbourhood-
+    // equivalent and this always passes; under 180 the cell map is not an automorphism
+    // of the lattice and it does not, and stamping there punches the art out of a
+    // height step's cover.  Measured on an Inland map (size 1, 2 players, seed
+    // 20260913) by rendering every stage: after CreateHills the map has 0 of 2721
+    // height steps without covering art and 0.04% dark pixels; CreateLATs took that to
+    // 73 of 2721 and 2.50% dark, and it was this stamp doing it.  With the guard the
+    // same map renders 0.30% dark and 0 uncovered steps.
+    //
+    // A cell that cannot be mirrored is dropped from BOTH halves: a half-stamped
+    // patch is exactly the asymmetry this work removes, so the source cell goes back
+    // to the tile it carried before the stamp.  Dropping the whole patch instead was
+    // tried first and costs far too much - one unmirrorable cell out of eighty kills
+    // the other seventy-nine (measured: 4609 of 5673 blob cells gone on that map).
+    std::vector<std::pair<int, int> > images;          // (image packed, source index)
+    for (size_t i = 0; i < stamped.size(); ++i)
+    {
+        const int16_t x = static_cast<int16_t>(stamped[i].packed & 0xFFFF);
+        const int16_t y = static_cast<int16_t>(
+                              static_cast<uint32_t>(stamped[i].packed) >> 16);
+        MapCell* src = CellAt(x, y);
+        int mx = 0, my = 0;
+        if (src == nullptr
+            || !mg::MirrorCell(size_.mapWidth, size_.mapHeight, config_.symmetry,
+                               x, y, &mx, &my))
+        {
+            if (src != nullptr)
+                src->IsoTileTypeIndex = stamped[i].oldTile;
+            ++g_mirrorStampDroppedCells;
+            continue;
+        }
+        if (mx == x && my == y)
+            continue;                                  // on the axis: its own image
+        MapCell* m = CellAt(mx, my);
+        if (m == nullptr || !IsPlaceholderTile(m))
+        {
+            src->IsoTileTypeIndex = stamped[i].oldTile;   // drop from both halves
+            ++g_mirrorStampDroppedCells;
+            continue;
+        }
+        images.push_back(std::make_pair(mx | (my << 16), static_cast<int>(i)));
+    }
+    if (images.empty())
+        ++g_mirrorStampDroppedBlobs;
+
+    // The image cells now hold the same, orientation-free tile index as their
+    // sources.
+    int mirrored = 0;
+    for (size_t k = 0; k < images.size(); ++k)
+    {
+        MapCell* m = CellAt(static_cast<int16_t>(images[k].first & 0xFFFF),
+                            static_cast<int16_t>(
+                                static_cast<uint32_t>(images[k].first) >> 16));
+        if (m == nullptr)
+            continue;
+        m->IsoTileTypeIndex = tileIndex;
+        ++mirrored;
+    }
+    return mirrored;
+}
+
