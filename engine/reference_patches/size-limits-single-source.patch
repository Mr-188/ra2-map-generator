+// SizeSliderRange -- the legal (and useful) sizeSlider bounds for one
+// (land, players) pair.  Both are DOUBLES: the parameter is continuous, and the
+// interesting bound is fractional (kSizeFractionMax of 1.2 is a size of 3.6).
+//
+// Derived by *asking CalcMapSize*, not by re-implementing it, so the two cannot
+// drift: this and the generator read the same tables and the same
+// kSizeFractionMax.
+//
+//   legalMax   the last value whose diamond still fits the fixed 512x512
+//              [OverlayPack] grid.  The grid is addressed x + 512*y over rows
+//              running to workSide - 1, so the test is on workSide, not on
+//              mapWidth/mapHeight separately (a 274x282 map is inside 512 on
+//              both axes yet needs 557 rows).  One step past this the writer
+//              would silently drop whole rows of overlays, so callers must
+//              reject it.
+//   usefulMax  the last value that actually CHANGES the map size.  The map size
+//              is a step function of the slider -- F2I64 quantises it to whole
+//              cells -- so "the next step changes nothing" would fire on the
+//              very first plateau.  What matters is where the changes stop: for
+//              the three clamped land types the fraction pins at
+//              kSizeFractionMax, so 3.6 is the final step that moves anything and
+//              every larger value repeats it; Inland and Mountainous keep growing
+//              and their usefulMax is their legalMax.
+//
+// The scan is quantised to kSizeSliderStep, which is also the step the page's
+// slider uses -- so the bounds reported here are values a caller can actually
+// ask for, and never one the writer would refuse.
+//
+// Concretely, with the retail tables:
+//   players 2-4  usefulMax 3.6,  legalMax 53.3
+//   players 5/6/7                legalMax 50.4 / 47.5 / 44.6
+//   players 8    usefulMax 3.6,  legalMax 22.1
+//   Inland/Mtn   usefulMax == legalMax
+//
+// For the three clamped land types legalMax comes back as the top of the scan
+// (just under kOverlayGridSide): the fraction is pinned at kSizeFractionMax, so
+// the map stops growing and every value is legal.  That is the intended answer,
+// not a sentinel -- those land types have no input the writer would refuse.
+// ---------------------------------------------------------------------------
+RandomMapGenerator::SizeRange
+RandomMapGenerator::SizeSliderRange(LandType land, int playerCount)
+{
+    SizeRange out = { 0.0, 0.0 };
+    int prevW = -1, prevH = -1;
+
+    const double step = kSizeSliderStep;
+    // Repeated += on a binary fraction accumulates error (3.6 comes out as
+    // 3.6000000000000005), and these values are handed to a UI as a slider's
+    // bounds.  Report them at the step's own precision.
+    auto snap = [step](double v) {
+        // Divide by the scale rather than multiply by step: 5119 * 0.1 comes out
+        // as 511.90000000000003, while 5119 / 10 gives the correctly rounded 511.9.
+        const double scale = (step > 0.0) ? (1.0 / step) : 1.0;
+        return std::floor(v * scale + 0.5) / scale;
+    };
+
+    // kOverlayGridSide / step is the worst case; for the clamped land types the
+    // scan does reach the end (nothing ever exceeds the grid), which is fine.
+    for (double s = 0.0; s <= static_cast<double>(kOverlayGridSide); s += step)
+    {
+        MapGenConfig cfg = {};
+        cfg.landType = land;
+        cfg.playerCount = playerCount;
+        cfg.sizeSlider = s;
+
+        const MapSizeResult here = CalcMapSize(cfg);
+        if (here.workSide > kOverlayGridSide)
+            break;                                  // s is illegal
+
+        out.legalMax = s;
+        if (here.mapWidth != prevW || here.mapHeight != prevH)
+        {
+            out.usefulMax = s;                      // this step moved the size
+            prevW = here.mapWidth;
+            prevH = here.mapHeight;
+        }
+    }
+    out.usefulMax = snap(out.usefulMax);
+    out.legalMax = snap(out.legalMax);
+    return out;
+}
+
+// ---------------------------------------------------------------------------
+// MaxRectCellSum -- the largest widthCells + heightCells that still fits the
+// overlay grid.
+//
+// The grid limit is on mapWidth + mapHeight, so a WIDE rectangle reaches sizes a
+// square cannot: maxRectCellSum is 495, i.e. 380x100 fits, and a square can only
+// ever be 247x247.  Measured against the retail tables, the Inland square cap and
+// a 380x100 rectangle both come out inside the same 512 grid.
+//
+// Derived by asking CalcMapSize with a 1-cell-tall rectangle, so the +4 / +12 / +1
+// in that function stay the only copy of them.
+// ---------------------------------------------------------------------------
+int RandomMapGenerator::MaxRectCellSum()
+{
+    int best = 0;
+    for (int w = 1; w <= 2 * kOverlayGridSide; ++w)
+    {
+        MapGenConfig cfg = {};
+        cfg.widthCells = w;
+        cfg.heightCells = 1;
+        if (CalcMapSize(cfg).workSide > kOverlayGridSide)
+            break;
+        best = w + 1;                                   // widthCells + heightCells
+    }
+    return best;
+}
