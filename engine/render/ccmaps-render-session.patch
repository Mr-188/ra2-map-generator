+		private static string ObjectKey(GameObject o) {
+			var t = o.Tile;
+			string k = o.GetType().Name + "|" + t.Rx + "," + t.Ry + "," + t.Z;
+			switch (o) {
+				case OverlayObject ov:
+					return k + "|" + ov.OverlayID + "|" + ov.OverlayValue;
+				case StructureObject st:
+					return k + "|" + st.Name + "|" + st.Owner + "|" + st.Direction + "|" + st.Health
+						+ "|" + st.Upgrade1 + "|" + st.Upgrade2 + "|" + st.Upgrade3 + "|" + st.PreCaptured;
+				case InfantryObject inf:
+					return k + "|" + inf.Name + "|" + inf.Owner + "|" + inf.Direction + "|" + inf.Health
+						+ "|" + inf.SubCell + "|" + inf.OnBridge;
+				case UnitObject un:
+					return k + "|" + un.Name + "|" + un.Owner + "|" + un.Direction + "|" + un.Health + "|" + un.OnBridge;
+				case AircraftObject ac:
+					return k + "|" + ac.Name + "|" + ac.Owner + "|" + ac.Direction + "|" + ac.Health + "|" + ac.OnBridge;
+				case TerrainObject tr:
+					return k + "|" + tr.Name;
+				case SmudgeObject sm:
+					return k + "|" + sm.Name;
+				default:
+					return k;
+			}
+		}
+
+		private void ReuseObjects(Dictionary<string, List<GameObject>> oldByKey) {
+			_reusedObjects.Clear();
+			ReuseList(_overlayObjects, oldByKey);
+			ReuseList(_terrainObjects, oldByKey);
+			ReuseList(_smudgeObjects, oldByKey);
+			ReuseList(_structureObjects, oldByKey);
+			ReuseList(_infantryObjects, oldByKey);
+			ReuseList(_unitObjects, oldByKey);
+			ReuseList(_aircraftObjects, oldByKey);
+		}
+
+		private void ReuseList<T>(List<T> objects, Dictionary<string, List<GameObject>> oldByKey) where T : GameObject {
+			for (int i = 0; i < objects.Count; i++) {
+				var fresh = objects[i];
+				var key = ObjectKey(fresh);
+				if (!oldByKey.TryGetValue(key, out var list) || list.Count == 0) continue;
+				var old = list[list.Count - 1];
+				list.RemoveAt(list.Count - 1);
+				fresh.Tile.RemoveObject(fresh, true);
+				fresh.Tile.AddObject(old);
+				objects[i] = (T)old;
+				_reusedObjects.Add(old);
+			}
+		}
+
+		public bool Reload(MapFile mf) {
+			if (mf.FullSize.Size != FullSize.Size) return false;
+			if (Theater.TheaterTypeFromString(mf.ReadString("Map", "Theater")) != TheaterType) return false;
+			_mapFile = mf;
+
+			_overlayObjects.Clear();
+			_smudgeObjects.Clear();
+			_terrainObjects.Clear();
+			_structureObjects.Clear();
+			_infantryObjects.Clear();
+			_unitObjects.Clear();
+			_aircraftObjects.Clear();
+			_wayPoints.Clear();
+			_overlaysAltered = false;
+
+			// Terrain is unchanged (our edits never touch IsoMapPack5), so keep the
+			// tile layer and its drawables; only the objects are replaced.  Unchanged
+			// objects are matched by cell + type + identity and reused with their
+			// drawable/palette, which avoids the bulk of the per-edit work.
+			try {
+				var oldByKey = new Dictionary<string, List<GameObject>>();
+				foreach (var tile in _tiles) {
+					if (tile == null) continue;
+					foreach (var obj in tile.AllObjects) {
+						if (obj is SmudgeObject sm && sm.FoundationCell != Point.Empty) continue;
+						var k = ObjectKey(obj);
+						if (!oldByKey.TryGetValue(k, out var list))
+							oldByKey[k] = list = new List<GameObject>();
+						list.Add(obj);
+					}
+					foreach (var obj in tile.AllObjects.ToList())
+						tile.RemoveObject(obj, true);
+				}
+				LoadAllObjects(mf, importTiles: false);
+				_wayPoints.AddRange(mf.Waypoints);
+				ReuseObjects(oldByKey);
+			} catch (Exception) { return false; }
+			try { RemoveUnknownObjects(); } catch (Exception) { return false; }
+			try { SetDrawables(includeTiles: false); } catch (Exception) { return false; }
+			try { ExpandSmudgeFootprints(); } catch (Exception) { return false; }
+			try { RevisitWallBuildings(); } catch (Exception) { return false; }
+			// Palettes/lighting are unchanged; reuse the per-level palettes from the
+			// first render and only assign palettes/remaps to the fresh objects.
+			try { LoadPalettes(); } catch (Exception) { return false; }
+			try { ApplyRemappables(); } catch (Exception) { return false; }
+			try { SetBaseTiles(); } catch (Exception) { return false; }
+			try { RecalculatePalettes(); } catch (Exception) { return false; }
+			return true;
+		}
