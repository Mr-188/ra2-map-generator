# Copy to .env and fill in.  .env is git-ignored: the token is an account
# credential, and it must never be committed.
#
#   cp .env.example .env
#   sh tools/deploy_edgeone.sh
#
# Everything here is optional if you pass the same thing on the command line
# (-n / -u / -t), and the token is optional if you ran
# `npx edgeone@1.6.41 login [--site china]` on this machine once.

# The EdgeOne project to update, exactly as the console shows it.  Deploying to
# the same name updates that project in place, so the custom domain and the
# HTTPS certificate are untouched.  A name that does not exist does NOT fail:
# the CLI creates a new project instead (deploy_edgeone.sh warns when it does).
#
# console, China site:         https://console.cloud.tencent.com/edgeone/pages
# console, international site: https://console.tencentcloud.com/edgeone/pages
EDGEONE_PROJECT=ra2-map-generator

# Verified after every deploy by tools/verify_deployed.sh (HTTP status and
# Content-Type of every asset the browser fetches).
EDGEONE_URL=https://map.example.com/

# Create it in the console, API Token tab:
#   China site:         https://console.cloud.tencent.com/edgeone/pages?tab=api
#     doc: https://cloud.tencent.com/document/product/1552/127422
#   International site: https://console.tencentcloud.com/edgeone/pages
#     doc: https://pages.edgeone.ai/zh/document/api-token
# Set an expiry (1 day to 1 year) -- it is an account credential.
#
# The CLI's own name for this is EDGEONE_PAGES_API_TOKEN; either works here.
# No region setting is needed: the CLI tries pages-api.cloud.tencent.com
# (China site) and pages-api.edgeone.ai (international) and uses whichever
# accepts the token.
EDGEONE_API_TOKEN=

# Optional: production (default) or preview.  Use preview to look at a build on
# a throwaway URL before it replaces what your domain serves.
#EDGEONE_ENV=production

# Optional, and only used when the CLI CREATES a project (global, the default,
# or overseas).  Updating an existing project ignores it.
#EDGEONE_AREA=global
